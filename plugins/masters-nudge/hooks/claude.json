{
  "description": "Masters’ Nudge lifecycle hooks for Claude Code.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude_checkpoint.py"],
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_command}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude_prompt.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
