{
  "description": "Masters’ Nudge lifecycle hooks for Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_python.sh\" \"${PLUGIN_ROOT}/hook_entry.py\" --host codex_cli",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\hooks\\run_python.cmd\" \"$env:PLUGIN_ROOT\\hook_entry.py\" --host codex_cli",
            "timeout": 5,
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_python.sh\" \"${PLUGIN_ROOT}/hook_entry.py\" --host codex_cli",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\hooks\\run_python.cmd\" \"$env:PLUGIN_ROOT\\hook_entry.py\" --host codex_cli",
            "timeout": 90,
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_python.sh\" \"${PLUGIN_ROOT}/hook_entry.py\" --host codex_cli --detach-stop",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\hooks\\run_python.cmd\" \"$env:PLUGIN_ROOT\\hook_entry.py\" --host codex_cli --detach-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
