{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "candidate_x", "candidate_y", "winner", "confidence", "reason"],
  "properties": {
    "task": {"type": "string"},
    "candidate_x": {"$ref": "#/$defs/candidate"},
    "candidate_y": {"$ref": "#/$defs/candidate"},
    "winner": {"enum": ["X", "Y", "tie"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "reason": {"type": "string", "maxLength": 900}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specific_preference", "load_bearing_reason", "actionability", "review_friction", "evidence"],
      "properties": {
        "specific_preference": {"type": "integer", "minimum": 0, "maximum": 2},
        "load_bearing_reason": {"type": "integer", "minimum": 0, "maximum": 2},
        "actionability": {"type": "integer", "minimum": 0, "maximum": 2},
        "review_friction": {"type": "integer", "minimum": 0, "maximum": 2},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 400}}
      }
    }
  }
}
