{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masters-nudge.local/shader-long-tail-candidate-ledger.schema.json",
  "title": "Shader long-tail candidate ledger",
  "type": "object",
  "required": ["schema_version", "run_id", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_frontier_id",
        "hypothesis_family",
        "falsifiable_statement",
        "evidence_refs",
        "mechanism_family",
        "expected_removed_work",
        "status",
        "contract_fingerprint",
        "source_fingerprint",
        "decision",
        "trajectory",
        "nudge_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
        "parent_frontier_id": {"type": "string", "minLength": 1},
        "hypothesis_family": {"type": "string", "minLength": 1},
        "falsifiable_statement": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "mechanism_family": {"type": "string", "minLength": 1},
        "expected_removed_work": {"type": "string", "minLength": 1},
        "refinement": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["changed_variable", "discriminating_measurement"],
              "properties": {
                "changed_variable": {"type": "string", "minLength": 1},
                "discriminating_measurement": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "implemented",
            "visual-rejected",
            "measured",
            "accepted",
            "rejected",
            "blocked"
          ]
        },
        "contract_fingerprint": {"type": "string", "minLength": 1},
        "source_fingerprint": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": true
        },
        "decision": {"type": "string"},
        "trajectory": {"enum": ["F2", "F1", "N", "B"]},
        "nudge_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
