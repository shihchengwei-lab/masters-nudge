{
  "_comment": "Masters’ Nudge for Codex CLI 0.147+. Merge only the hooks entries you need into ~/.codex/hooks.json; keep existing hooks. Commands point at the default neutral runtime installed by install.sh/install.ps1.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.masters-nudge/runtime/hook_entry.py --host codex_cli",
            "commandWindows": "py -3 \"$env:USERPROFILE\\.masters-nudge\\runtime\\hook_entry.py\" --host codex_cli",
            "timeout": 5,
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.masters-nudge/runtime/hook_entry.py --host codex_cli",
            "commandWindows": "py -3 \"$env:USERPROFILE\\.masters-nudge\\runtime\\hook_entry.py\" --host codex_cli",
            "timeout": 90,
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.masters-nudge/runtime/hook_entry.py --host codex_cli --detach-stop",
            "commandWindows": "py -3 \"$env:USERPROFILE\\.masters-nudge\\runtime\\hook_entry.py\" --host codex_cli --detach-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
