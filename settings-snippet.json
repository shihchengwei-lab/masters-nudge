{
  "_comment": "Masters’ Nudge compatibility install: merge these entries into the 'hooks' section of ~/.claude/settings.json. Do NOT replace your whole settings.json. Existing buddy-named script paths are intentionally preserved. If you already have other hooks, keep them and add ours alongside.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/buddy/checkpoint.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/buddy/checkpoint.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/buddy/buddy.sh",
            "timeout": 90,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/buddy/inject.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
