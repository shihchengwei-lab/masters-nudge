+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useState } from 'react';
+import { act, fireEvent, render } from '@testing-library/react';
+import '@testing-library/jest-dom';
+
+import { FilteredDeviceList } from '../../../../../src/components/views/settings/devices/FilteredDeviceList';
+import { DeviceSecurityVariation } from '../../../../../src/components/views/settings/devices/types';
+import SessionManagerTab from '../../../../../src/components/views/settings/tabs/user/SessionManagerTab';
+import { useOwnDevices } from '../../../../../src/components/views/settings/devices/useOwnDevices';
+import MatrixClientContext from '../../../../../src/contexts/MatrixClientContext';
+import Modal from '../../../../../src/Modal';
+import {
+    flushPromisesWithFakeTimers,
+    getMockClientWithEventEmitter,
+    mockClientMethodsUser,
+    mockPlatformPeg,
+} from '../../../../test-utils';
+
+jest.mock('../../../../../src/components/views/settings/devices/useOwnDevices');
+mockPlatformPeg();
+
+describe('Bulk session selection', () => {
+    const devices = {
+        first: { device_id: 'first', display_name: 'First session', isVerified: true },
+        second: { device_id: 'second', display_name: 'Second session', isVerified: false },
+    };
+    const props = {
+        devices,
+        pushers: [],
+        localNotificationSettings: new Map(),
+        expandedDeviceIds: [],
+        signingOutDeviceIds: [],
+        onFilterChange: jest.fn(),
+        onDeviceExpandToggle: jest.fn(),
+        onSignOutDevices: jest.fn(),
+        saveDeviceName: jest.fn(),
+        setPushNotifications: jest.fn(),
+    };
+
+    beforeEach(() => jest.clearAllMocks());
+    afterEach(() => jest.restoreAllMocks());
+
+    it.each([false, true])('toggles selection and count with caller-owned state: %s', (controlled) => {
+        const ControlledList = () => {
+            const [selectedDeviceIds, setSelectedDeviceIds] = useState<string[]>([]);
+            return <FilteredDeviceList {...props}
+                selectedDeviceIds={selectedDeviceIds} setSelectedDeviceIds={setSelectedDeviceIds}
+            />;
+        };
+        const { getByTestId, getByText, queryByTestId } = render(
+            controlled ? <ControlledList /> : <FilteredDeviceList {...props} />,
+        );
+        const first = getByTestId('device-tile-checkbox-first');
+        const second = getByTestId('device-tile-checkbox-second');
+        expect(queryByTestId('sign-out-selection-cta')).toBeNull();
+        fireEvent.click(first);
+        expect(first).toBeChecked();
+        expect(getByText('1 sessions selected')).toBeTruthy();
+        fireEvent.click(getByText('Second session'));
+        expect(second).toBeChecked();
+        expect(getByText('2 sessions selected')).toBeTruthy();
+        fireEvent.click(getByText('First session'));
+        expect(first).not.toBeChecked();
+        expect(getByText('1 sessions selected')).toBeTruthy();
+        fireEvent.click(first);
+        fireEvent.click(getByTestId('sign-out-selection-cta'));
+        expect(props.onSignOutDevices).toHaveBeenCalledTimes(1);
+        expect(props.onSignOutDevices).toHaveBeenCalledWith(['second', 'first']);
+        fireEvent.click(getByTestId('cancel-selection-cta'));
+        expect(first).not.toBeChecked();
+        expect(second).not.toBeChecked();
+        expect(queryByTestId('cancel-selection-cta')).toBeNull();
+    });
+
+    it('keeps tile actions independent of selection', () => {
+        const { getByTestId } = render(<FilteredDeviceList {...props} />);
+        fireEvent.click(getByTestId('device-tile-first').querySelector('[aria-label="Toggle device details"]'));
+        expect(props.onDeviceExpandToggle).toHaveBeenCalledWith('first');
+        expect(getByTestId('device-tile-checkbox-first')).not.toBeChecked();
+    });
+
+    it.each([false, true])('clears selection on filter change with caller-owned state: %s', (controlled) => {
+        const List = ({ filter }: { filter?: DeviceSecurityVariation }) => {
+            const [selectedDeviceIds, setSelectedDeviceIds] = useState<string[]>([]);
+            return controlled
+                ? <FilteredDeviceList {...props} filter={filter}
+                    selectedDeviceIds={selectedDeviceIds} setSelectedDeviceIds={setSelectedDeviceIds}
+                />
+                : <FilteredDeviceList {...props} filter={filter} />;
+        };
+        const { getByTestId, queryByTestId, rerender } = render(<List />);
+        fireEvent.click(getByTestId('device-tile-checkbox-first'));
+        rerender(<List filter={DeviceSecurityVariation.Verified} />);
+        expect(getByTestId('device-tile-checkbox-first')).not.toBeChecked();
+        expect(queryByTestId('sign-out-selection-cta')).toBeNull();
+    });
+
+    describe('Session manager sign-out', () => {
+        const client = getMockClientWithEventEmitter({
+            ...mockClientMethodsUser('@alice:example.org'),
+            deleteMultipleDevices: jest.fn(),
+        });
+        const refreshDevices = jest.fn().mockResolvedValue(undefined);
+
+        const renderManager = async () => {
+            const result = render(<MatrixClientContext.Provider value={client}>
+                <SessionManagerTab />
+            </MatrixClientContext.Provider>);
+            fireEvent.click(result.getByTestId('device-tile-checkbox-first'));
+            fireEvent.click(result.getByTestId('device-tile-checkbox-second'));
+            await act(async () => {
+                fireEvent.click(result.getByTestId('sign-out-selection-cta'));
+                await flushPromisesWithFakeTimers();
+            });
+            return result;
+        };
+
+        beforeEach(() => {
+            client.deleteMultipleDevices.mockReset();
+            (useOwnDevices as jest.MockedFunction<typeof useOwnDevices>).mockReturnValue({
+                ...props,
+                devices: { current: { device_id: 'current', isVerified: true }, ...devices },
+                currentDeviceId: 'current',
+                isLoadingDeviceList: false,
+                refreshDevices,
+                supportsMSC3881: false,
+            });
+        });
+
+        it('deletes all selected IDs in one request, refreshes and clears selection', async () => {
+            client.deleteMultipleDevices.mockResolvedValue(undefined);
+            const { getByTestId, queryByTestId } = await renderManager();
+            expect(client.deleteMultipleDevices).toHaveBeenCalledTimes(1);
+            expect(client.deleteMultipleDevices).toHaveBeenCalledWith(['first', 'second'], undefined);
+            expect(refreshDevices).toHaveBeenCalledTimes(1);
+            expect(getByTestId('device-tile-checkbox-first')).not.toBeChecked();
+            expect(queryByTestId('sign-out-selection-cta')).toBeNull();
+        });
+
+        it('clears loading on authentication cancellation and preserves selection for retry', async () => {
+            const modalSpy = jest.spyOn(Modal, 'createDialog').mockImplementation(() => undefined);
+            client.deleteMultipleDevices.mockRejectedValueOnce({
+                httpStatus: 401, data: { flows: [{ stages: ['m.login.password'] }] },
+            });
+            const { getByTestId } = await renderManager();
+            expect(getByTestId('sign-out-selection-cta')).toHaveAttribute('aria-disabled', 'true');
+            const { onFinished } = modalSpy.mock.calls[0][1] as { onFinished: (success: boolean) => Promise<void> };
+            await act(async () => { await onFinished(false); });
+            expect(getByTestId('sign-out-selection-cta')).not.toHaveAttribute('aria-disabled', 'true');
+            expect(getByTestId('device-tile-checkbox-first')).toBeChecked();
+            expect(refreshDevices).not.toHaveBeenCalled();
+            client.deleteMultipleDevices.mockResolvedValue(undefined);
+            await act(async () => {
+                fireEvent.click(getByTestId('sign-out-selection-cta'));
+                await flushPromisesWithFakeTimers();
+            });
+            expect(refreshDevices).toHaveBeenCalledTimes(1);
+        });
+    });
+});
