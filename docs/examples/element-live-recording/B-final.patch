diff --git a/test/components/views/settings/devices/BulkSessionSelection-test.tsx b/test/components/views/settings/devices/BulkSessionSelection-test.tsx
new file mode 100644
index 0000000000..d720d87d80
--- /dev/null
+++ b/test/components/views/settings/devices/BulkSessionSelection-test.tsx
@@ -0,0 +1,175 @@
+/*
