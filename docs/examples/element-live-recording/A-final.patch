diff --git a/test/components/views/settings/tabs/user/SessionManagerSelection-test.tsx b/test/components/views/settings/tabs/user/SessionManagerSelection-test.tsx
new file mode 100644
index 0000000000..d9cc4923af
--- /dev/null
+++ b/test/components/views/settings/tabs/user/SessionManagerSelection-test.tsx
@@ -0,0 +1,203 @@
+/*
