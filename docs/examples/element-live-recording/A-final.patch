+
+import React from 'react';
+import { act, fireEvent, render, within } from '@testing-library/react';
+
+import SessionManagerTab from '../../../../../../src/components/views/settings/tabs/user/SessionManagerTab';
+import { useOwnDevices } from '../../../../../../src/components/views/settings/devices/useOwnDevices';
+import MatrixClientContext from '../../../../../../src/contexts/MatrixClientContext';
+import Modal from '../../../../../../src/Modal';
+import InteractiveAuthDialog from '../../../../../../src/components/views/dialogs/InteractiveAuthDialog';
+import { getMockClientWithEventEmitter, mockClientMethodsUser, mockPlatformPeg } from '../../../../../test-utils';
+
+jest.mock('../../../../../../src/components/views/settings/devices/useOwnDevices');
+
+describe('Session manager selection', () => {
+    const devices = {
+        current: { device_id: 'current', isVerified: true },
+        first: { device_id: 'first', display_name: 'First session', isVerified: true },
+        second: { device_id: 'second', display_name: 'Second session', isVerified: false },
+    };
+    const client = getMockClientWithEventEmitter({
+        ...mockClientMethodsUser('@alice:example.org'),
+        deleteMultipleDevices: jest.fn(),
+    });
+    const refreshDevices = jest.fn();
+
+    const renderSessions = () => render(
+        <MatrixClientContext.Provider value={client}>
+            <SessionManagerTab />
+        </MatrixClientContext.Provider>,
+    );
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+        mockPlatformPeg();
+        client.deleteMultipleDevices.mockReset().mockResolvedValue(undefined);
+        refreshDevices.mockReset().mockResolvedValue(undefined);
+        (useOwnDevices as jest.Mock).mockReturnValue({
+            devices,
+            currentDeviceId: 'current',
+            pushers: [],
+            localNotificationSettings: new Map(),
+            isLoadingDeviceList: false,
+            refreshDevices,
+            saveDeviceName: jest.fn(),
+            setPushNotifications: jest.fn(),
+        });
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it('toggles selection from checkboxes and tile information and shows the count', () => {
+        const view = renderSessions();
+        const first = view.getByTestId('device-tile-checkbox-first') as HTMLInputElement;
+        const second = view.getByTestId('device-tile-checkbox-second') as HTMLInputElement;
+        expect(first.checked).toBe(false);
+        expect(view.queryByTestId('device-tile-checkbox-current')).toBeNull();
+
+        fireEvent.click(first);
+        expect(first.checked).toBe(true);
+        expect(view.getByText('1 sessions selected')).toBeTruthy();
+        fireEvent.click(view.getByText('Second session'));
+        expect(second.checked).toBe(true);
+        expect(view.getByText('2 sessions selected')).toBeTruthy();
+
+        fireEvent.click(view.getByText('First session'));
+        expect(first.checked).toBe(false);
+        fireEvent.click(second);
+        expect(second.checked).toBe(false);
+        expect(view.queryByTestId('sign-out-selection-cta')).toBeNull();
+        expect(view.queryByTestId('cancel-selection-cta')).toBeNull();
+    });
+
+    it('keeps selection when expanding details and clears all checkboxes on cancel', () => {
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-second'));
+        fireEvent.click(within(view.getByTestId('device-tile-first')).getByLabelText('Toggle device details'));
+        expect(view.getByTestId('device-detail-first')).toBeTruthy();
+        expect(view.getByText('2 sessions selected')).toBeTruthy();
+
+        fireEvent.click(view.getByTestId('cancel-selection-cta'));
+        expect((view.getByTestId('device-tile-checkbox-first') as HTMLInputElement).checked).toBe(false);
+        expect((view.getByTestId('device-tile-checkbox-second') as HTMLInputElement).checked).toBe(false);
+        expect(view.queryByTestId('sign-out-selection-cta')).toBeNull();
+        expect(client.deleteMultipleDevices).not.toHaveBeenCalled();
+    });
+
+    it('clears selection when the dropdown filter changes', () => {
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        fireEvent.click(view.getByLabelText('Filter devices'));
+        fireEvent.click(view.container.querySelector('#device-list-filter__Verified'));
+        expect(view.queryByTestId('sign-out-selection-cta')).toBeNull();
+        expect((view.getByTestId('device-tile-checkbox-first') as HTMLInputElement).checked).toBe(false);
+    });
+
+    it('clears selection when a security recommendation changes the filter', () => {
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-second'));
+        fireEvent.click(view.getByTestId('unverified-devices-cta'));
+        expect(view.queryByTestId('sign-out-selection-cta')).toBeNull();
+        expect(view.queryByTestId('device-tile-checkbox-first')).toBeNull();
+        expect((view.getByTestId('device-tile-checkbox-second') as HTMLInputElement).checked).toBe(false);
+    });
+
+    it('sends selected IDs in one request, refreshes devices and clears successful selection', async () => {
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-second'));
+        await act(async () => {
+            fireEvent.click(view.getByTestId('sign-out-selection-cta'));
+        });
+
+        expect(client.deleteMultipleDevices).toHaveBeenCalledTimes(1);
+        expect(client.deleteMultipleDevices).toHaveBeenCalledWith(['first', 'second'], undefined);
+        expect(refreshDevices).toHaveBeenCalledTimes(1);
+        expect(view.queryByTestId('sign-out-selection-cta')).toBeNull();
+        expect((view.getByTestId('device-tile-checkbox-first') as HTMLInputElement).checked).toBe(false);
+    });
+
+    it('clears loading after authentication cancellation and allows retrying the selection', async () => {
+        client.deleteMultipleDevices.mockRejectedValueOnce({
+            httpStatus: 401,
+            data: { flows: [{ stages: ['m.login.password'] }] },
+        });
+        const createDialog = jest.spyOn(Modal, 'createDialog').mockReturnValue({
+            finished: Promise.resolve([]),
+            close: jest.fn(),
+        });
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-second'));
+        await act(async () => {
+            fireEvent.click(view.getByTestId('sign-out-selection-cta'));
+        });
+        expect(view.getByTestId('sign-out-selection-cta').getAttribute('aria-disabled')).toBe('true');
+        expect(createDialog.mock.calls[0][0]).toBe(InteractiveAuthDialog);
+        await act(async () => {
+            await createDialog.mock.calls[0][1].onFinished(false);
+        });
+
+        expect(view.getByTestId('sign-out-selection-cta').getAttribute('aria-disabled')).toBeNull();
+        expect(view.getByText('2 sessions selected')).toBeTruthy();
+        expect(refreshDevices).not.toHaveBeenCalled();
+        await act(async () => {
+            fireEvent.click(view.getByTestId('sign-out-selection-cta'));
+        });
+        expect(client.deleteMultipleDevices).toHaveBeenCalledTimes(2);
+        expect(refreshDevices).toHaveBeenCalledTimes(1);
+    });
+
+    it('keeps other requests loading when an earlier authentication is cancelled', async () => {
+        client.deleteMultipleDevices.mockRejectedValue({
+            httpStatus: 401,
+            data: { flows: [{ stages: ['m.login.password'] }] },
+        });
+        const createDialog = jest.spyOn(Modal, 'createDialog').mockReturnValue({
+            finished: Promise.resolve([]),
+            close: jest.fn(),
+        });
+        const view = renderSessions();
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        await act(async () => {
+            fireEvent.click(view.getByTestId('sign-out-selection-cta'));
+        });
+        fireEvent.click(view.getByTestId('cancel-selection-cta'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-second'));
+        await act(async () => {
+            fireEvent.click(view.getByTestId('sign-out-selection-cta'));
+        });
+
+        await act(async () => {
+            await createDialog.mock.calls[0][1].onFinished(false);
+        });
+        expect(view.getByTestId('sign-out-selection-cta').getAttribute('aria-disabled')).toBe('true');
+        await act(async () => {
+            await createDialog.mock.calls[1][1].onFinished(false);
+        });
+        expect(view.getByTestId('sign-out-selection-cta').getAttribute('aria-disabled')).toBeNull();
+        fireEvent.click(view.getByTestId('cancel-selection-cta'));
+        fireEvent.click(view.getByTestId('device-tile-checkbox-first'));
+        expect(view.getByTestId('sign-out-selection-cta').getAttribute('aria-disabled')).toBeNull();
+        expect(refreshDevices).not.toHaveBeenCalled();
+    });
+});
