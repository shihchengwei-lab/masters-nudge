 var foo = /(?:a|b)/
+var foo = /c+|[a-f]/
 
 /* ✗ BAD */
 var foo = /a|a/
@@ -34,6 +37,10 @@ var foo = /[ab]|[ba]/
 var foo = /a|abc/
 var foo = /.|abc/
 var foo = /.|a|b|c/
+var foo = /a+|[abc]/
+var foo = /a+|[a-f]/
+var foo = /a|[ab]a/
+var foo = /a+|(?:a|b)/
 ```
 
 </eslint-code-block>
