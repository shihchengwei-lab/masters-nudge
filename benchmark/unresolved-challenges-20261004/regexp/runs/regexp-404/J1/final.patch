+/** Yields removable choices, visiting enclosing choices before their children. */
+function* iterateNestedElements(
+    node: Node,
+): Iterable<Alternative | CharacterClassElement> {
+    switch (node.type) {
+        case "Alternative":
+            for (const element of node.elements) {
+                yield* iterateNestedElements(element)
+            }
+            break
+        case "Group":
+        case "CapturingGroup":
+            if (node.type === "CapturingGroup" && node.references.length > 0) {
+                // Coverage outside the group does not preserve the captured
+                // value used by later backreferences.
+                break
+            }
+            for (const alternative of node.alternatives) {
+                if (node.alternatives.length > 1) {
+                    yield alternative
+                }
+                yield* iterateNestedElements(alternative)
+            }
+            break
+        case "Quantifier":
+            if (node.max > 0) {
+                yield* iterateNestedElements(node.element)
+            }
+            break
+        case "CharacterClass":
+            if (!node.negate) {
+                for (const element of node.elements) {
+                    yield element
+                    if (element.type === "CharacterClassRange") {
+                        yield element.min
+                        if (element.min.value !== element.max.value) {
+                            yield element.max
+                        }
+                    }
+                }
+            }
+            break
+        default:
+            // Assertions have their own disjunctions. In particular, choices
+            // inside a negative assertion cannot be removed this way.
+            break
