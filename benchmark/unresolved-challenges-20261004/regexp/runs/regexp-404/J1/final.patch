+/**
+ * Projects a tagged NFA onto the original alphabet, keeping only paths that
+ * passed the marker. Each original state has an unvisited and a visited copy.
+ */
+function removeMarker(nfa: NFA, marker: number): NFA {
+    const product = ENFA.empty({ maxCharacter: marker - 1 })
+    const states = new Map<
+        NFA.Node,
+        { unvisited: ENFA.Node; visited: ENFA.Node }
+    >()
+    for (const state of nfa.nodes) {
+        states.set(state, {
+            unvisited: product.nodes.createNode(),
+            visited: product.nodes.createNode(),
+        })
+    }
+    product.nodes.initial = states.get(nfa.nodes.initial)!.unvisited
+
+    for (const [state, from] of states) {
+        if (nfa.nodes.finals.has(state)) {
+            product.nodes.linkNodes(from.visited, product.nodes.final, null)
+        }
+        for (const [next, chars] of state.out) {
+            const to = states.get(next)!
+            const markerRange = { min: marker, max: marker }
+            const characters = CharSet.empty(marker - 1).union(
+                chars.without([markerRange]).ranges,
+            )
+            if (!characters.isEmpty) {
+                product.nodes.linkNodes(
+                    from.unvisited,
+                    to.unvisited,
+                    characters,
+                )
+                product.nodes.linkNodes(from.visited, to.visited, characters)
+            }
+            if (chars.isSupersetOf(markerRange)) {
+                // Use a separate state so epsilon and character transitions
+                // never have to share an edge in the ENFA.
+                const marked = product.nodes.createNode()
+                product.nodes.linkNodes(from.unvisited, marked, null)
+                product.nodes.linkNodes(from.visited, marked, null)
+                product.nodes.linkNodes(marked, to.visited, null)
+            }
+        }
+    }
+    return NFA.fromFA(product)
+}
