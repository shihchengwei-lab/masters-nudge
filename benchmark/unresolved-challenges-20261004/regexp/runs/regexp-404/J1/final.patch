+/**
+ * Returns all paths of the alternative that visit the selected element at
+ * least once. A marker outside the original alphabet tracks visits while the
+ * original quantifiers retain their exact minimum and maximum repetitions.
+ */
+function toNestedNFA(
+    parser: JS.Parser,
+    alternative: Alternative,
+    element: Alternative | CharacterClassElement,
+    flags: ReadonlyFlags,
+): NFA | null {
+    try {
+        const maxCharacter: number = parser.maxCharacter
+        const marker = maxCharacter + 1
+        let nfa: NFA
+        if (element.type === "Alternative") {
+            const parsed = toNFA(parser, element, marker)
+            if (parsed.partial) {
+                return null
+            }
+            nfa = parsed.nfa
+        } else {
+            nfa = NFA.fromRegex(
+                {
+                    type: "CharacterClass",
+                    characters: CharSet.empty(marker).union(
+                        toCharSet(element, flags).ranges,
+                    ),
+                },
+                { maxCharacter: marker },
+            )
+        }
+        nfa.prepend(NFA.fromWords([[marker]], { maxCharacter: marker }))
+
+        for (let current: Node = element; current !== alternative; ) {
+            const parent: Node | null = current.parent
+            if (!parent) {
+                return null
+            }
+            if (parent.type === "Alternative") {
+                const index = parent.elements.indexOf(
+                    current as Alternative["elements"][number],
+                )
+                for (let i = index - 1; i >= 0; i--) {
+                    const parsed = toNFA(parser, parent.elements[i], marker)
+                    if (parsed.partial) {
+                        return null
+                    }
+                    nfa.prepend(parsed.nfa)
+                }
+                for (let i = index + 1; i < parent.elements.length; i++) {
+                    const parsed = toNFA(parser, parent.elements[i], marker)
+                    if (parsed.partial) {
+                        return null
+                    }
+                    nfa.append(parsed.nfa)
+                }
+            } else if (parent.type === "Quantifier") {
+                nfa.quantify(parent.min, parent.max)
+            } else if (
+                parent.type === "Group" ||
+                parent.type === "CapturingGroup" ||
+                parent.type === "CharacterClass"
+            ) {
+                // Other iterations may choose any unmarked path. Only the
+                // visited copy of an accepting state will accept in the product.
+                const unmarked = toNFA(parser, parent, marker)
+                if (unmarked.partial) {
+                    return null
+                }
+                nfa.union(unmarked.nfa)
+            }
+            current = parent
+        }
+        return removeMarker(nfa, marker)
+    } catch (error) {
+        return null
+    }
+}
