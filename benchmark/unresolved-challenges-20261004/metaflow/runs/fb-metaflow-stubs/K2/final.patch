+    def _exploit_annotation(self, annotation: Any, starting: str = ": ") -> str:
+        """Format an annotation, recording the names needed by the stub."""
+        if annotation is None or annotation is inspect.Parameter.empty:
+            return ""
+
+        def forward(name):
+            name = re.sub(
+                r"\bmetaflow_extensions(?:\.[A-Za-z_]\w*)*",
+                lambda match: self._get_module_name_alias(match.group()),
+                name,
+            )
+            try:
+                expression = ast.parse(name, mode="eval")
+            except SyntaxError:
+                expression = None
+            if expression is not None:
+                for node in ast.walk(expression):
+                    if not isinstance(node, ast.Attribute):
+                        continue
+                    parts = []
+                    while isinstance(node, ast.Attribute):
+                        parts.append(node.attr)
+                        node = node.value
+                    if isinstance(node, ast.Name):
+                        parts.append(node.id)
+                        module_name = ".".join(reversed(parts[1:]))
+                        if module_name != self._current_module_name:
+                            self._typing_imports.add(module_name)
+            return '"%s"' % (
+                name.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
+            )
+
+        def is_self_reference(value):
+            if not inspect.isclass(value) or self._current_name is None:
+                return False
+            module = self._current_parent_module or self._current_module
+            current = self._current_objects.get(self._current_name)
+            if current is None and module is not None:
+                current = vars(module).get(self._current_name)
+            if inspect.isclass(current):
+                return value is current
+            return (
+                value.__name__ == self._current_name
+                and module is not None
+                and value.__module__ == module.__name__
+            )
+
+        def format_type(value):
+            if value is None or value is type(None):
+                return "None"
+            if isinstance(value, str):
+                if value == self._current_name:
+                    return forward(value)
+                namespace = dict(globals())
+                module = self._current_parent_module or self._current_module
+                if module is not None:
+                    namespace.update(vars(module))
+                try:
+                    resolved = eval(value, namespace)
+                except Exception:
+                    return forward(value)
+                # Quoted annotations and aliases can evaluate to another string.
+                # Keep it as a reference instead of repeatedly evaluating it.
+                return (
+                    forward(resolved)
+                    if isinstance(resolved, str)
+                    else format_type(resolved)
+                )
+            if isinstance(value, ForwardRef):
+                return forward(value.__forward_arg__)
+            if isinstance(value, TypeVar) or hasattr(value, "__supertype__"):
+                return self._get_element_name_with_module(value)
+            if value is Ellipsis:
+                return "..."
+
+            origin = typing.get_origin(value)
+            args = typing.get_args(value)
+            if origin is not None and origin is not value:
+                alias = getattr(value, "_name", None)
+                self_generic = is_self_reference(origin)
+                if alias:
+                    self._imports.add("typing")
+                    base = "typing." + alias
+                elif origin is typing.Union or origin is getattr(types, "UnionType", None):
+                    self._imports.add("typing")
+                    base = "typing.Union"
+                else:
+                    base = self._current_name if self_generic else format_type(origin)
+                if not args:
+                    # Tuple[()] has no arguments, just like the unparameterized
+                    # Tuple, but represents a tuple with exactly zero elements.
+                    if origin is tuple and hasattr(value, "__args__"):
+                        return base + "[()]"
+                    return base
+                if alias == "Optional":
+                    args = args[:1]
+                if origin is getattr(typing, "Literal", None):
+                    arguments = [self._format_default(arg) for arg in args]
+                elif origin is getattr(typing, "Annotated", None):
+                    arguments = [format_type(args[0])] + [
+                        self._format_default(arg) for arg in args[1:]
+                    ]
+                elif origin is typing.get_origin(typing.Callable):
+                    parameters, result = args
+                    if isinstance(parameters, (tuple, list)):
+                        parameters = "[%s]" % ", ".join(
+                            format_type(arg) for arg in parameters
+                        )
+                    else:
+                        parameters = format_type(parameters)
+                    arguments = [parameters, format_type(result)]
+                else:
+                    arguments = [format_type(arg) for arg in args]
+                result = "%s[%s]" % (base, ", ".join(arguments))
+                return forward(result) if self_generic else result
+
+            if getattr(value, "__module__", None) == "typing":
+                self._imports.add("typing")
+            if is_self_reference(value):
+                return forward(self._current_name)
+            return self._get_element_name_with_module(value)
+
+        return starting + format_type(annotation)
