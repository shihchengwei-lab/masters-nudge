+                if typed_dict:
+                    # TypedDict flattens inherited annotations. __total__ alone
+                    # describes only this class, not the inherited keys.
+                    required = field in clazz.__required_keys__
+                    optional = field in clazz.__optional_keys__
+                    if required_marker is not None:
