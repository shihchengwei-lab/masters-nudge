+def type_var_to_str(t: TypeVar, format_annotation=None) -> str:
+    if format_annotation is None:
+        format_annotation = lambda value: (
+            repr(value.__forward_arg__)
+            if isinstance(value, ForwardRef)
+            else getattr(value, "__name__", str(value))
+        )
+    arguments = ['"%s"' % t.__name__]
+    # Constraints are positional arguments and must precede variance and bound.
+    arguments.extend(format_annotation(value) for value in t.__constraints__)
+    if t.__bound__ is not None:
+        bound = format_annotation(t.__bound__)
+        if not bound.startswith(("'", '"')):
+            bound = '"%s"' % bound
+        arguments.append("bound=" + bound)
+    arguments.extend(
+        [
+            "contravariant=%s" % t.__contravariant__,
+            "covariant=%s" % t.__covariant__,
+        ]
+    )
+    return "typing.TypeVar(%s)" % ", ".join(arguments)
