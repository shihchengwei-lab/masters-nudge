+    def _typed_dict_annotation(self, annotation):
+        """Separate a field's type from its explicit requiredness, if any."""
+        namespace = dict(globals())
+        if self._current_parent_module is not None:
+            namespace.update(vars(self._current_parent_module))
+        if isinstance(annotation, ForwardRef):
+            annotation = annotation.__forward_arg__
+        if isinstance(annotation, str):
+            try:
+                resolved = eval(annotation, namespace)
+            except Exception:
+                resolved = annotation
+            if isinstance(resolved, str):
+                try:
+                    expression = ast.parse(resolved, mode="eval").body
+                    if isinstance(expression, ast.Subscript):
+                        # Resolve the qualifier separately from the field type:
+                        # Required[Missing] is meaningful even before Missing
+                        # can be imported or defined.
+                        qualifier = eval(
+                            compile(ast.Expression(expression.value), "<annotation>", "eval"),
+                            namespace,
+                        )
+                        qualifier_name = getattr(qualifier, "__name__", "")
+                        if qualifier_name in ("Required", "NotRequired"):
+                            return (
+                                ForwardRef(ast.get_source_segment(resolved, expression.slice)),
+                                qualifier_name == "Required",
+                            )
+                except Exception:
+                    pass
+                return ForwardRef(resolved), None
+            annotation = resolved
+        origin = typing.get_origin(annotation)
+        qualifier_name = getattr(origin, "__name__", "")
+        if qualifier_name in ("Required", "NotRequired"):
+            return typing.get_args(annotation)[0], qualifier_name == "Required"
+        if origin is getattr(typing, "Annotated", None) and origin is not None:
+            args = typing.get_args(annotation)
+            field_type, marker = self._typed_dict_annotation(args[0])
+            return typing.Annotated[(field_type,) + args[1:]], marker
+        return annotation, None
