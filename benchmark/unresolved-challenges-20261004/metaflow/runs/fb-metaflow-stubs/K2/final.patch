+    def _format_default(self, value: Any) -> str:
+        if value is Ellipsis:
+            return "..."
+        if isinstance(value, enum.Enum):
+            return "%s.%s" % (
+                self._get_element_name_with_module(type(value), force_import=True),
+                value.name,
+            )
+        if inspect.isclass(value):
+            return self._get_element_name_with_module(value, force_import=True)
+        try:
+            result = repr(value)
+            ast.literal_eval(result)
+        except Exception:
+            return "..."
+        return result
