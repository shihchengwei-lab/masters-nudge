+def test_generate_metaflow_stubs(generator, tmp_path):
+    generator.write_out()
+    files = list(tmp_path.rglob("*.pyi"))
+    assert len(files) > 10
+    for path in files:
+        ast.parse(path.read_text(), filename=str(path))
+    current = (tmp_path / "metaflow_current.pyi").read_text()
+    assert "def project_name(self) -> str:" in current
+    deployer = ast.parse((tmp_path / "runner" / "deployer.pyi").read_text())
+    deployer_class = next(n for n in deployer.body if isinstance(n, ast.ClassDef) and n.name == "Deployer")
+    deployed_class = next(n for n in deployer.body if isinstance(n, ast.ClassDef) and n.name == "DeployedFlow")
+    from metaflow.plugins import DEPLOYER_IMPL_PROVIDERS
+
+    for provider in DEPLOYER_IMPL_PROVIDERS:
+        method_name = provider.TYPE.replace("-", "_")
+        method = next(n for n in deployer_class.body if getattr(n, "name", None) == method_name)
+        assert method.returns is not None
+        assert provider.__name__ in ast.unparse(method.returns)
+        deployed_type = typing.get_args(
+            inspect.signature(provider.deployed_flow_type).return_annotation
+        )[0]
+        expected_type = deployed_type.__forward_arg__.split(".")[-1]
+        method = next(n for n in deployed_class.body if getattr(n, "name", None) == "from_" + method_name)
