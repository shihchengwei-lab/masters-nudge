+    def _format_docstring(doc: str, indentation: str) -> str:
+        # Escape the source representation while preserving the actual docstring.
+        doc = inspect.cleandoc(doc).replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
+        return add_indent(indentation, '"""\n' + doc + '\n"""') + "\n"
