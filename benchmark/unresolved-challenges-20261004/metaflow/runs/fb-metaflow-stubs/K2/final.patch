+            named_tuple = issubclass(clazz, tuple) and hasattr(clazz, "_fields")
+            bases = []
+            if typed_dict or named_tuple:
+                self._imports.add("typing")
+                bases.append("typing.TypedDict" if typed_dict else "typing.NamedTuple")
+                if typed_dict and not clazz.__total__:
+                    bases.append("total=False")
+            else:
+                for base in clazz.__dict__.get("__orig_bases__", clazz.__bases__):
+                    if base is object:
+                        continue
+                    origin = typing.get_origin(base) or base
+                    self._get_element_name_with_module(origin, force_import=True)
+                    bases.append(self._exploit_annotation(base, ""))
+                if type(clazz) is not type:
+                    bases.append(
+                        "metaclass=" + self._get_element_name_with_module(
+                            type(clazz), force_import=True
