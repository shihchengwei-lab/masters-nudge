+def test_class_members_and_descriptors(generator):
+    exec(
+        '''
+class Meta(type): pass
+class Base: pass
+class Example(Base, metaclass=Meta):
+    """Example documentation."""
+    count: int = 2
+    peer: "Example"
+    label = "example"
+    def __init__(self, value: int = 0): pass
+    @staticmethod
+    def build(value: int) -> "Example": pass
+    @classmethod
+    def create(cls, value: int) -> "Example": pass
+    @property
+    def value(self) -> int: return 0
+    @value.setter
+    def value(self, value: int) -> None: pass
+    def _private(self): pass
+    def ignored(self):
+        """STUBGEN_IGNORE"""
+def injected(self, text: str) -> bool: pass
+Example.injected = injected
+''',
+        generator._current_module.__dict__,
+    )
+    clazz = generator._current_module.Example
+    result = generator._generate_class_stub("Example", clazz)
+    node = ast.parse(result).body[0]
+    assert ast.get_docstring(node) == "Example documentation."
+    assert [ast.unparse(b) for b in node.bases] == ["Base"]
+    assert ast.unparse(node.keywords[0].value) == "Meta"
+    methods = [n for n in node.body if isinstance(n, ast.FunctionDef)]
+    assert [m.args.args[0].arg for m in methods if m.name == "create"] == ["cls"]
+    assert {m.name for m in methods} == {"__init__", "build", "create", "value", "injected"}
+    decorators = [ast.unparse(d) for m in methods for d in m.decorator_list]
+    assert decorators == ["staticmethod", "classmethod", "property", "value.setter"]
+    fields = {n.target.id: ast.unparse(n.annotation) for n in node.body if isinstance(n, ast.AnnAssign)}
+    assert fields == {"count": "int", "peer": "'Example'", "label": "str"}
+    assert generator._current_name is None
