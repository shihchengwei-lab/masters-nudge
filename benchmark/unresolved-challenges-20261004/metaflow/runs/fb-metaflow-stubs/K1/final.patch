+def test_metaflow_methods_preserve_runtime_overloads(generator):
+    generator._current_module.DeployerImpl = stub_generator.DeployerImpl
+    clazz = define(generator, """
+class CustomDeployer(DeployerImpl):
+    @typing.overload
+    def create(self, value: int) -> int: ...
+    @typing.overload
+    def create(self, value: str) -> str: ...
+    def create(self, value): pass
+""", "CustomDeployer")
+    methods = [n for n in class_node(generator, clazz).body if isinstance(n, ast.FunctionDef)]
+    assert [ast.unparse(n.returns) for n in methods] == ["int", "str"]
+    assert all("typing.overload" in [ast.unparse(d) for d in n.decorator_list] for n in methods)
+
+
+def test_type_definitions_write_valid_stubs(generator, tmp_path):
+    module = generator._current_module
+    module.__file__ = str(tmp_path / "stub_example.py")
+    define(generator, """
+Scalar = typing.TypeVar('Scalar', int, str)
+Stamp = typing.NewType('Stamp', datetime.datetime)
+def convert(value: Scalar, stamp: Stamp) -> Scalar: pass
+""", "convert")
+    generator._pending_modules = [("metaflow.stub_example", module.__name__)]
+    generator.write_out()
+    source = (tmp_path / "stubs" / "stub_example.pyi").read_text()
+    namespace = {}
+    exec(source, namespace)
+    assert not any(
+        isinstance(n, ast.AnnAssign) and n.target.id in ("Scalar", "Stamp")
+        for n in ast.parse(source).body
+    )
+    assert namespace["Scalar"].__constraints__ == (int, str)
+    assert namespace["Stamp"].__supertype__ is datetime.datetime
+
+
+def test_generate_complete_checkout_stubs(generator, tmp_path):
+    generator.write_out()
+    files = list((tmp_path / "stubs").rglob("*.pyi"))
+    assert len(files) > 10
+    for path in files:
+        ast.parse(path.read_text(), filename=str(path))
+    source = (tmp_path / "stubs" / "metaflow_current.pyi").read_text()
+    assert "def project_name(self) -> str:" in source
+    assert "def parallel(self)" in source
+    assert "def flow_name(self)" in source
