+        .with(Recorder::default().with_filter(LevelFilter::INFO));
+    assert!(subscriber.register_callsite(&MANUAL_META).is_always());
+    let subscriber = Registry::default()
+        .with(Recorder::default().with_filter(LevelFilter::ERROR))
+        .with(Recorder::default().with_filter(LevelFilter::OFF));
+    assert!(subscriber.register_callsite(&MANUAL_META).is_never());
+    let subscriber = Registry::default()
+        .with(Recorder::default().with_filter(LevelFilter::INFO))
+        .with(Recorder::default().with_filter(LevelFilter::OFF));
+    assert!(subscriber.register_callsite(&MANUAL_META).is_sometimes());
+}
