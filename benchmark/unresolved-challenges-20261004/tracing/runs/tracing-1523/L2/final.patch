+#[derive(Clone, Default)]
+struct LookupProbe(Arc<Mutex<Option<span::Id>>>);
+impl<S> Layer<S> for LookupProbe
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn on_event(&self, _: &Event<'_>, ctx: Context<'_, S>) {
+        let id = self.0.lock().unwrap().clone().unwrap();
+        assert!(ctx.span(&id).is_none());
+        assert!(ctx.metadata(&id).is_none());
+        assert!(!ctx.exists(&id));
+        assert_eq!(
+            ctx.span_scope(&id)
+                .unwrap()
+                .map(|s| s.name())
+                .collect::<Vec<_>>(),
+            vec!["visible_root"]
+        );
+    }
+}
