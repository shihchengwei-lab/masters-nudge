+#[test]
+fn max_level_hints_combine_branches_and_enclosing_bounds() {
+    let subscriber = Registry::default()
+        .with(Recorder::default().with_filter(LevelFilter::INFO))
+        .with(Recorder::default().with_filter(LevelFilter::DEBUG));
+    assert_eq!(subscriber.max_level_hint(), Some(LevelFilter::DEBUG));
+    assert_eq!(subscriber.with(Recorder::default()).max_level_hint(), None);
+    let subscriber = Registry::default()
+        .with(Recorder::default())
+        .with(Recorder::default().with_filter(LevelFilter::INFO));
+    assert_eq!(subscriber.max_level_hint(), None);
+    assert_eq!(
+        subscriber.with(LevelFilter::WARN).max_level_hint(),
+        Some(LevelFilter::WARN)
+    );
+    let subtree = Recorder::default()
+        .with_filter(LevelFilter::TRACE)
+        .and_then(Recorder::default())
+        .with_filter(LevelFilter::INFO);
+    assert_eq!(
+        Registry::default().with(subtree).max_level_hint(),
+        Some(LevelFilter::INFO)
+    );
+    let subscriber = Registry::default()
+        .with(LevelFilter::WARN)
+        .with(Recorder::default().with_filter(LevelFilter::TRACE));
+    assert_eq!(subscriber.max_level_hint(), Some(LevelFilter::WARN));
+    let filter = FilterFn::new(|_| true).with_max_level_hint(tracing::Level::TRACE);
+    assert_eq!(
+        Filter::<Registry>::max_level_hint(&filter),
+        Some(LevelFilter::TRACE)
+    );
+    let filter =
+        DynFilterFn::<Registry, _>::new(|_, _| true).with_max_level_hint(tracing::Level::DEBUG);
+    assert_eq!(
+        Filter::<Registry>::max_level_hint(&filter),
+        Some(LevelFilter::DEBUG)
+    );
+}
