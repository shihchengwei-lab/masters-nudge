+#[test]
+fn dynamic_filters_follow_context_and_changing_state() {
+    let output = Recorder::default();
+    let active = Arc::new(AtomicBool::new(false));
+    let enabled = active.clone();
+    let subscriber = Registry::default().with(output.clone().with_filter(dynamic_filter_fn(
+        move |m, ctx: &Context<'_, Registry>| {
+            m.is_span() || (enabled.load(Ordering::SeqCst) && ctx.lookup_current().is_some())
+        },
+    )));
+    tracing::subscriber::with_default(subscriber, || {
+        for in_span in [false, true, false].iter().copied() {
+            let span = tracing::info_span!("context");
+            let _entered = if in_span { Some(span.enter()) } else { None };
+            for on in [false, true, false].iter().copied() {
+                active.store(on, Ordering::SeqCst);
+                tracing::info!(target: "dynamic", "reevaluate");
+            }
+        }
+    });
+    assert_eq!(
+        output
+            .entries()
+            .iter()
+            .filter(|s| s.starts_with("event:"))
+            .collect::<Vec<_>>(),
+        vec!["event:dynamic:context"]
+    );
