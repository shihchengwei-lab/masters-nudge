+#[test]
+fn nested_filters_restrict_subtrees_and_preserve_ancestor_views() {
+    let left = Recorder::default();
+    let right = Recorder::default();
+    let all = Recorder::default();
+    let subtree = left
+        .clone()
+        .with_filter(filter_fn(|m| m.name() != "middle"))
+        .and_then(right.clone())
+        .with_filter(filter_fn(|m| {
+            m.name() != "outer_hidden" && m.target() != "blocked"
+        }));
+    let subscriber = Registry::default().with(subtree).with(all.clone());
+    tracing::subscriber::with_default(subscriber, || {
+        let root = tracing::info_span!("root");
+        let _root = root.enter();
+        let outer = tracing::info_span!("outer_hidden");
+        let _outer = outer.enter();
+        let middle = tracing::info_span!("middle", field = tracing::field::Empty);
+        let _middle = middle.enter();
+        middle.record("field", &1);
+        tracing::info!(target: "contextual", "contextual");
+        tracing::info!(target: "explicit", parent: &middle, "explicit");
+        let leaf = tracing::info_span!("leaf");
+        let _leaf = leaf.enter();
+        tracing::info!(target: "leaf_event", "leaf");
+        tracing::info!(target: "blocked", "only unfiltered");
+    });
+    let events = |recorder: &Recorder| {
+        recorder
+            .entries()
+            .into_iter()
+            .filter(|s| s.starts_with("event:"))
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(
+        events(&left),
+        vec![
+            "event:contextual:root",
+            "event:explicit:root",
+            "event:leaf_event:leaf/root"
+        ]
+    );
+    assert_eq!(
+        events(&right),
+        vec![
+            "event:contextual:middle/root",
+            "event:explicit:middle/root",
+            "event:leaf_event:leaf/middle/root"
+        ]
+    );
+    assert_eq!(events(&all).len(), 4);
+    assert!(!left
+        .entries()
+        .iter()
+        .any(|s| s.ends_with(":middle") || s.ends_with(":outer_hidden")));
+    assert!(!right.entries().iter().any(|s| s.ends_with(":outer_hidden")));
+    assert!(left.entries().contains(&"close:root".to_owned()));
+}
