+#[derive(Clone, Default)]
+struct Recorder(Arc<Mutex<Vec<String>>>);
+
+impl Recorder {
+    fn entries(&self) -> Vec<String> {
+        self.0.lock().unwrap().clone()
+    }
+}
+
+impl<S> Layer<S> for Recorder
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn new_span(&self, _: &span::Attributes<'_>, id: &span::Id, ctx: Context<'_, S>) {
+        let span = ctx.span(id).unwrap();
+        let parent = span.parent().map(|p| p.id());
+        assert_eq!(span.parent_id(), parent.as_ref());
+        self.0.lock().unwrap().push(format!("new:{}", span.name()));
+    }
+
+    fn on_event(&self, event: &Event<'_>, ctx: Context<'_, S>) {
+        let scope = ctx
+            .event_scope(event)
+            .into_iter()
+            .flatten()
+            .map(|s| s.name())
+            .collect::<Vec<_>>()
+            .join("/");
+        let current = ctx.lookup_current();
+        assert_eq!(
+            ctx.current_span().id(),
+            current.as_ref().map(|s| s.id()).as_ref()
+        );
+        if let Some(span) = current {
+            assert!(ctx.exists(&span.id()));
+            assert_eq!(ctx.metadata(&span.id()).unwrap().name(), span.name());
+            if let Some(parent) = span.parent() {
+                assert_eq!(
+                    parent.scope().map(|s| s.name()).collect::<Vec<_>>(),
+                    span.scope().skip(1).map(|s| s.name()).collect::<Vec<_>>()
+                );
+            }
+        }
+        self.0
+            .lock()
+            .unwrap()
+            .push(format!("event:{}:{}", event.metadata().target(), scope));
+    }
+
+    fn on_record(&self, id: &span::Id, _: &span::Record<'_>, ctx: Context<'_, S>) {
+        self.0
+            .lock()
+            .unwrap()
+            .push(format!("record:{}", ctx.span(id).unwrap().name()));
+    }
+
+    fn on_enter(&self, id: &span::Id, ctx: Context<'_, S>) {
+        self.0
+            .lock()
+            .unwrap()
+            .push(format!("enter:{}", ctx.span(id).unwrap().name()));
+    }
+
+    fn on_exit(&self, id: &span::Id, ctx: Context<'_, S>) {
+        self.0
+            .lock()
+            .unwrap()
+            .push(format!("exit:{}", ctx.span(id).unwrap().name()));
+    }
+
+    fn on_close(&self, id: span::Id, ctx: Context<'_, S>) {
+        self.0
+            .lock()
+            .unwrap()
+            .push(format!("close:{}", ctx.span(&id).unwrap().name()));
+    }
+}
