+#[test]
+fn explicit_lookup_and_current_span_hide_rejected_roots() {
+    struct Probe(Arc<Mutex<Option<span::Id>>>);
+    impl<S> Layer<S> for Probe
+    where
+        S: Subscriber + for<'a> LookupSpan<'a>,
+    {
+        fn on_event(&self, _: &Event<'_>, cx: Context<'_, S>) {
+            let hidden = self.0.lock().unwrap();
+            let hidden = hidden.as_ref().unwrap();
+            assert!(cx.span(hidden).is_none());
+            assert!(cx.metadata(hidden).is_none());
+            assert!(!cx.exists(hidden));
+            assert!(cx.span_scope(hidden).is_none());
+            assert_eq!(cx.lookup_current().unwrap().name(), "visible");
+            assert_eq!(cx.current_span().metadata().unwrap().name(), "visible");
+        }
+    }
+    let hidden_id = Arc::new(Mutex::new(None));
+    let subscriber = Registry::default()
+        .with(Probe(hidden_id.clone()).with_filter(filter::filter_fn(|m| m.name() != "hidden")))
+        .with(Seen::default());
+    tracing::subscriber::with_default(subscriber, || {
+        let _visible = tracing::info_span!("visible").entered();
+        let hidden = tracing::info_span!(parent: None, "hidden");
+        *hidden_id.lock().unwrap() = hidden.id();
+        let _hidden = hidden.enter();
+        tracing::info!("different entered roots");
+    });
+}
