new file mode 100644
index 0000000..3a98731
--- /dev/null
+++ b/tracing-subscriber/src/filter/filter_fn.rs
@@ -0,0 +1,203 @@
+use super::{layer_filters::Filter, LevelFilter};
+use crate::layer::Context;
+use std::{any::type_name, fmt, marker::PhantomData};
+use tracing_core::{Interest, Metadata};
+
+/// A per-layer filter using a metadata-only predicate.
+///
+/// The predicate must return the same result for a callsite each time it is
+/// evaluated. Use [`DynFilterFn`] for predicates depending on mutable state or
+/// the current span.
+#[derive(Clone)]
+pub struct FilterFn<F = fn(&Metadata<'_>) -> bool> {
+    enabled: F,
+    max_level_hint: Option<LevelFilter>,
+}
+
+/// A per-layer filter using a predicate that can inspect the current context.
+///
+/// By default the predicate is evaluated for every event or span. Stable
+/// callsite decisions can be supplied with [`Self::with_callsite_filter`].
+pub struct DynFilterFn<
+    S,
+    F = fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+    R = fn(&'static Metadata<'static>) -> Interest,
+> {
+    enabled: F,
+    callsite: Option<R>,
+    max_level_hint: Option<LevelFilter>,
+    _s: PhantomData<fn(S)>,
+}
+
+/// Constructs a metadata-only per-layer filter.
+pub fn filter_fn<F>(enabled: F) -> FilterFn<F>
+where
+    F: Fn(&Metadata<'_>) -> bool,
+{
+    FilterFn::new(enabled)
+}
+
+/// Constructs a context-sensitive per-layer filter.
+pub fn dynamic_filter_fn<S, F>(enabled: F) -> DynFilterFn<S, F>
+where
+    F: Fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+{
+    DynFilterFn::new(enabled)
+}
+
+impl<F> FilterFn<F>
+where
+    F: Fn(&Metadata<'_>) -> bool,
+{
+    /// Constructs a filter from a metadata-only predicate.
+    pub fn new(enabled: F) -> Self {
+        Self {
+            enabled,
+            max_level_hint: None,
+        }
+    }
+
+    /// Specifies the most verbose level this predicate may enable.
+    pub fn with_max_level_hint(mut self, hint: impl Into<LevelFilter>) -> Self {
+        self.max_level_hint = Some(hint.into());
+        self
+    }
+}
+
+impl<S, F> Filter<S> for FilterFn<F>
+where
+    F: Fn(&Metadata<'_>) -> bool,
+{
+    fn enabled(&self, metadata: &Metadata<'_>, _: &Context<'_, S>) -> bool {
+        (self.enabled)(metadata)
+    }
+    fn callsite_enabled(&self, metadata: &'static Metadata<'static>) -> Interest {
+        if (self.enabled)(metadata) {
+            Interest::always()
+        } else {
+            Interest::never()
+        }
+    }
+    fn max_level_hint(&self) -> Option<LevelFilter> {
+        self.max_level_hint
+    }
+}
+
+impl<S, F> DynFilterFn<S, F>
+where
+    F: Fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+{
+    /// Constructs a filter evaluated with the current context on each use.
+    pub fn new(enabled: F) -> Self {
+        Self {
+            enabled,
+            callsite: None,
+            max_level_hint: None,
+            _s: PhantomData,
+        }
+    }
+}
+
+impl<S, F, R> DynFilterFn<S, F, R>
+where
+    F: Fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+{
+    /// Specifies the most verbose level this predicate may enable.
+    pub fn with_max_level_hint(mut self, hint: impl Into<LevelFilter>) -> Self {
+        self.max_level_hint = Some(hint.into());
+        self
+    }
+
+    /// Adds a predicate for stable callsite decisions.
+    ///
+    /// Returning `sometimes` runs the context-sensitive predicate on each use.
+    /// Returning `always` or `never` promises that result for every context.
+    pub fn with_callsite_filter<R2>(self, callsite: R2) -> DynFilterFn<S, F, R2>
+    where
+        R2: Fn(&'static Metadata<'static>) -> Interest,
+    {
+        DynFilterFn {
+            enabled: self.enabled,
+            callsite: Some(callsite),
+            max_level_hint: self.max_level_hint,
+            _s: PhantomData,
+        }
+    }
+}
+
+impl<S, F, R> Filter<S> for DynFilterFn<S, F, R>
+where
+    F: Fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+    R: Fn(&'static Metadata<'static>) -> Interest,
+{
+    fn enabled(&self, metadata: &Metadata<'_>, cx: &Context<'_, S>) -> bool {
+        (self.enabled)(metadata, cx)
+    }
+    fn callsite_enabled(&self, metadata: &'static Metadata<'static>) -> Interest {
+        if self
+            .max_level_hint
+            .map(|hint| metadata.level() > &hint)
+            .unwrap_or(false)
+        {
+            return Interest::never();
+        }
+        self.callsite
+            .as_ref()
+            .map(|f| f(metadata))
+            .unwrap_or_else(Interest::sometimes)
+    }
+    fn max_level_hint(&self) -> Option<LevelFilter> {
+        self.max_level_hint
+    }
+}
+
+impl<F> fmt::Debug for FilterFn<F> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FilterFn")
+            .field("enabled", &type_name::<F>())
+            .field("max_level_hint", &self.max_level_hint)
+            .finish()
+    }
+}
+
+impl<S, F, R> fmt::Debug for DynFilterFn<S, F, R> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("DynFilterFn")
+            .field("enabled", &type_name::<F>())
+            .field(
+                "callsite",
+                &self.callsite.as_ref().map(|_| type_name::<R>()),
+            )
+            .field("max_level_hint", &self.max_level_hint)
+            .finish()
+    }
+}
+
+impl<S, F: Clone, R: Clone> Clone for DynFilterFn<S, F, R> {
+    fn clone(&self) -> Self {
+        Self {
+            enabled: self.enabled.clone(),
+            callsite: self.callsite.clone(),
+            max_level_hint: self.max_level_hint,
+            _s: PhantomData,
+        }
+    }
+}
+
+impl<F> From<F> for FilterFn<F>
+where
+    F: Fn(&Metadata<'_>) -> bool,
+{
+    fn from(f: F) -> Self {
+        Self::new(f)
+    }
+}
+
+impl<S, F> From<F> for DynFilterFn<S, F>
+where
+    F: Fn(&Metadata<'_>, &Context<'_, S>) -> bool,
+{
+    fn from(f: F) -> Self {
+        Self::new(f)
+    }
+}
