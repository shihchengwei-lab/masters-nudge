+#[test]
+fn nested_filters_preserve_ancestor_views_and_callbacks() {
+    let nested = Seen::default();
+    let sibling = Seen::default();
+    let all = Seen::default();
+    let subtree = nested
+        .clone()
+        .with_filter(filter::filter_fn(|m| m.name() != "middle"))
+        .and_then(sibling.clone())
+        .with_filter(filter::filter_fn(|m| m.name() != "hidden"));
+    let subscriber = Registry::default().with(subtree).with(all.clone());
+    let dispatch = tracing::Dispatch::new(subscriber);
+    let mut closed = Vec::new();
+    tracing::dispatcher::with_default(&dispatch, || {
+        let root = tracing::info_span!("root");
+        let _root = root.enter();
+        let middle = tracing::info_span!("middle", value = tracing::field::Empty);
+        let _middle = middle.enter();
+        let hidden = tracing::info_span!("hidden", value = tracing::field::Empty);
+        let _hidden = hidden.enter();
+        let leaf = tracing::info_span!("leaf");
+        let _leaf = leaf.enter();
+        middle.record("value", &1);
+        hidden.record("value", &1);
+        leaf.follows_from(&middle);
+        tracing::info!("contextual");
+        tracing::info!(parent: &hidden, "explicit hidden parent");
+        closed.extend([
+            root.id().unwrap(),
+            middle.id().unwrap(),
+            hidden.id().unwrap(),
+            leaf.id().unwrap(),
+        ]);
+    });
+    let nested = nested.take();
+    assert!(nested.contains(&"event:INFO:leaf,root".to_owned()));
+    assert!(nested.contains(&"event:INFO:root".to_owned()));
+    assert!(!nested
+        .iter()
+        .any(|s| s.contains("middle") || s.contains("hidden")));
+    let sibling = sibling.take();
+    assert!(sibling.contains(&"event:INFO:leaf,middle,root".to_owned()));
+    assert!(!sibling.iter().any(|s| s.contains("hidden")));
+    assert!(all
+        .take()
+        .contains(&"event:INFO:leaf,hidden,middle,root".to_owned()));
+    let registry = dispatch.downcast_ref::<Registry>().unwrap();
+    for id in closed {
+        assert!(registry.span(&id).is_none());
+    }
+}
