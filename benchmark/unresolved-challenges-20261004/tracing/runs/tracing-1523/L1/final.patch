+    impl Filter<Registry> for DefaultFilter {
+        fn enabled(&self, _: &Metadata<'_>, _: &Context<'_, Registry>) -> bool {
+            true
+        }
+    }
+    tracing::subscriber::with_default(Registry::default(), || {
+        let span = tracing::info_span!("metadata");
+        let m = span.metadata().unwrap();
+        assert!(DefaultFilter.callsite_enabled(m).is_sometimes());
+        assert_eq!(DefaultFilter.max_level_hint(), None);
+        let static_filter = <FilterFn>::new(|_| true).with_max_level_hint(Level::TRACE);
+        assert!(<FilterFn as Filter<Registry>>::callsite_enabled(&static_filter, m).is_always());
+        let dynamic = DynFilterFn::<Registry>::new(|_, _| true).with_max_level_hint(Level::TRACE);
+        assert!(dynamic.callsite_enabled(m).is_sometimes());
+        let stable = dynamic.with_callsite_filter(|_| Interest::never());
+        assert!(stable.callsite_enabled(m).is_never());
+    });
+}
