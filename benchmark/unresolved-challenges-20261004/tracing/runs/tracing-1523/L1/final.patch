+#[test]
+fn custom_subscriber_current_span_uses_entered_spans_not_ancestry() {
+    // A custom LookupSpan subscriber need not expose Registry by downcasting.
+    struct OpaqueRegistry(Registry);
+    impl Subscriber for OpaqueRegistry {
+        fn enabled(&self, _: &Metadata<'_>) -> bool {
+            true
+        }
+        fn new_span(&self, attrs: &span::Attributes<'_>) -> span::Id {
+            self.0.new_span(attrs)
+        }
+        fn record(&self, id: &span::Id, values: &span::Record<'_>) {
+            self.0.record(id, values)
+        }
+        fn record_follows_from(&self, id: &span::Id, follows: &span::Id) {
+            self.0.record_follows_from(id, follows)
+        }
+        fn event(&self, event: &Event<'_>) {
+            self.0.event(event)
+        }
+        fn enter(&self, id: &span::Id) {
+            self.0.enter(id)
+        }
+        fn exit(&self, id: &span::Id) {
+            self.0.exit(id)
+        }
+        fn clone_span(&self, id: &span::Id) -> span::Id {
+            self.0.clone_span(id)
+        }
+        fn try_close(&self, id: span::Id) -> bool {
+            self.0.try_close(id)
+        }
+        fn current_span(&self) -> tracing_core::span::Current {
+            self.0.current_span()
+        }
+    }
+    impl<'a> LookupSpan<'a> for OpaqueRegistry {
+        type Data = tracing_subscriber::registry::Data<'a>;
+        fn span_data(&'a self, id: &span::Id) -> Option<Self::Data> {
+            self.0.span_data(id)
+        }
+    }
+    struct CheckCurrent;
+    impl<S> Layer<S> for CheckCurrent
+    where
+        S: Subscriber + for<'a> LookupSpan<'a>,
+    {
+        fn on_event(&self, event: &Event<'_>, cx: Context<'_, S>) {
+            assert_eq!(cx.current_span().metadata().unwrap().name(), "visible");
+            assert_eq!(cx.lookup_current().unwrap().name(), "visible");
+            assert_eq!(
+                cx.event_scope(event)
+                    .unwrap()
+                    .map(|s| s.name())
+                    .collect::<Vec<_>>(),
+                ["visible"]
+            );
+        }
+    }
+    let subscriber = OpaqueRegistry(Registry::default())
+        .with(CheckCurrent.with_filter(filter::filter_fn(|m| m.name() != "hidden")))
+        .with(Seen::default());
+    tracing::subscriber::with_default(subscriber, || {
+        let _visible = tracing::info_span!("visible").entered();
+        let _hidden = tracing::info_span!(parent: None, "hidden").entered();
+        tracing::info!("custom current span");
+    });
+}
