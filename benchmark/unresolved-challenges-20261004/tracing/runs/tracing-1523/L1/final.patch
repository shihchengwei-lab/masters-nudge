@@ -0,0 +1,575 @@
+#![cfg(feature = "registry")]
+
+use std::sync::{Arc, Mutex};
+use tracing::{span, Event, Level, Metadata, Subscriber};
+use tracing_core::subscriber::Interest;
+use tracing_subscriber::{
+    filter::{self, DynFilterFn, FilterFn, LevelFilter},
+    layer::{Context, Filter, Layer},
+    prelude::*,
+    registry::{LookupSpan, Registry},
+};
+
+#[derive(Clone, Default)]
+struct Seen(Arc<Mutex<Vec<String>>>);
+
+impl Seen {
+    fn take(&self) -> Vec<String> {
+        std::mem::take(&mut *self.0.lock().unwrap())
+    }
+
+    fn push(&self, value: String) {
+        self.0.lock().unwrap().push(value);
+    }
+}
+
+impl<S> Layer<S> for Seen
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn new_span(&self, attrs: &span::Attributes<'_>, id: &span::Id, cx: Context<'_, S>) {
+        assert!(cx.exists(id));
+        assert_eq!(cx.metadata(id).unwrap().name(), attrs.metadata().name());
+        let span = cx.span(id).unwrap();
+        assert_eq!(span.parent_id().cloned(), span.parent().map(|s| s.id()));
+        self.push(format!("new:{}", span.name()));
+    }
+
+    fn on_event(&self, event: &Event<'_>, cx: Context<'_, S>) {
+        let scope = cx
+            .event_scope(event)
+            .into_iter()
+            .flatten()
+            .map(|s| s.name())
+            .collect::<Vec<_>>();
+        let current = cx.lookup_current();
+        assert_eq!(
+            cx.current_span().id().cloned(),
+            current.as_ref().map(|s| s.id())
+        );
+        if let Some(span) = cx.event_span(event) {
+            let parents = span
+                .parent()
+                .into_iter()
+                .flat_map(|s| s.scope())
+                .map(|s| s.name())
+                .collect::<Vec<_>>();
+            assert_eq!(parents, scope[1..]);
+            assert_eq!(
+                cx.span_scope(&span.id())
+                    .unwrap()
+                    .map(|s| s.name())
+                    .collect::<Vec<_>>(),
+                scope
+            );
+        }
+        self.push(format!(
+            "event:{}:{}",
+            event.metadata().level(),
+            scope.join(",")
+        ));
+    }
+
+    fn on_record(&self, id: &span::Id, _: &span::Record<'_>, cx: Context<'_, S>) {
+        self.push(format!("record:{}", cx.span(id).unwrap().name()));
+    }
+
+    fn on_enter(&self, id: &span::Id, cx: Context<'_, S>) {
+        self.push(format!("enter:{}", cx.span(id).unwrap().name()));
+    }
+
+    fn on_exit(&self, id: &span::Id, cx: Context<'_, S>) {
+        self.push(format!("exit:{}", cx.span(id).unwrap().name()));
+    }
+
+    fn on_close(&self, id: span::Id, cx: Context<'_, S>) {
+        self.push(format!("close:{}", cx.span(&id).unwrap().name()));
+    }
+
+    fn on_follows_from(&self, id: &span::Id, follows: &span::Id, cx: Context<'_, S>) {
+        self.push(format!(
+            "follows:{}:{}",
+            cx.span(id).unwrap().name(),
+            cx.span(follows).unwrap().name()
+        ));
+    }
+}
