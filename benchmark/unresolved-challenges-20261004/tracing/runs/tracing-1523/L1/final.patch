+#[test]
+fn reentrant_delivery_keeps_the_outer_decision_snapshot() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    struct Reenter(Arc<AtomicBool>);
+    impl<S: Subscriber> Layer<S> for Reenter {
+        fn on_event(&self, event: &Event<'_>, cx: Context<'_, S>) {
+            if self.0.swap(false, Ordering::SeqCst) {
+                // Re-evaluate and deliver the very same callsite to the inner
+                // subscriber while the outer event is still being delivered.
+                cx.enabled(event.metadata());
+                cx.event(event);
+            }
+        }
+    }
+    let active = Arc::new(AtomicBool::new(true));
+    let inner = Seen::default();
+    let outer = Seen::default();
+    let inner_active = active.clone();
+    let outer_active = active.clone();
+    let subscriber = Registry::default()
+        .with(
+            inner
+                .clone()
+                .with_filter(filter::dynamic_filter_fn(move |_, _| {
+                    inner_active.load(Ordering::SeqCst)
+                })),
+        )
+        .with(Reenter(active.clone()))
+        .with(
+            outer
+                .clone()
+                .with_filter(filter::dynamic_filter_fn(move |_, _| {
+                    outer_active.load(Ordering::SeqCst)
+                })),
+        );
+    tracing::subscriber::with_default(subscriber, || {
+        for _ in 0..3 {
+            active.store(true, Ordering::SeqCst);
+            tracing::info!("reentrant");
+        }
+    });
+    assert_eq!(inner.take(), ["event:INFO:"].repeat(3));
+    assert_eq!(outer.take(), ["event:INFO:"].repeat(3));
+}
