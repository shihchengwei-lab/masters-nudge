+                if origin is collections.abc.Callable and args:
+                    parameters, result = args
+                    if isinstance(parameters, (list, tuple)):
+                        parameters = "[%s]" % ", ".join(
+                            format_type(p) for p in parameters
+                        )
+                    else:
