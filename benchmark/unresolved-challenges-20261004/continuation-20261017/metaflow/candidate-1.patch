+def test_classes_preserve_annotations_descriptors_and_runtime_members(generator):
+    clazz = define(generator, '''
+class Meta(type): pass
+class Base: pass
+class Example(Base, metaclass=Meta):
+    """Class documentation."""
+    label: str
+    count: typing.ClassVar[int] = 3
+    category = "example"
+    def __init__(self, label: str): pass
+    def __iter__(self): pass
+    def _private(self): pass
+    @staticmethod
+    def static(value: int) -> bool: pass
+    @classmethod
+    def create(cls, label: str) -> "Example": pass
+    @property
+    def value(self) -> int: raise AssertionError("Do not evaluate properties")
+    @value.setter
+    def value(self, value: int) -> None: pass
+def runtime(self, enabled: bool = True) -> str: pass
+Example.injected = runtime
+''', "Example")
+    node = class_node(generator, clazz)
+    assert ast.get_docstring(node) == "Class documentation."
+    assert [ast.unparse(b) for b in node.bases] == ["Base"]
+    assert ast.unparse(node.keywords[0].value) == "Meta"
+    annotations = {n.target.id: ast.unparse(n.annotation) for n in node.body if isinstance(n, ast.AnnAssign)}
+    assert annotations == {"label": "str", "count": "typing.ClassVar[int]", "category": "str"}
+    methods = [n for n in node.body if isinstance(n, ast.FunctionDef)]
+    assert "_private" not in [n.name for n in methods]
+    assert {"__init__", "__iter__", "static", "create", "value", "injected"} <= {n.name for n in methods}
+    by_name = {n.name: n for n in methods}
+    assert by_name["create"].args.args[0].arg == "cls"
+    assert [ast.unparse(d) for d in by_name["create"].decorator_list] == ["classmethod"]
+    assert [ast.unparse(d) for d in by_name["static"].decorator_list] == ["staticmethod"]
+    assert [[ast.unparse(d) for d in n.decorator_list] for n in methods if n.name == "value"] == [["property"], ["value.setter"]]
+    assert ast.unparse(by_name["__init__"].returns) == "None"
+
