+    def _exploit_annotation(self, annotation: Any, starting: str = ": ") -> str:
+        """Format an annotation and collect the imports and type definitions it uses."""
+        if annotation is None or annotation is inspect.Parameter.empty:
+            return ""
 
+        def forward_reference(value):
+            value = self._get_module_name_alias(value)
+            module, _, _ = value.rpartition(".")
+            if (
+                module
+                and all(part.isidentifier() for part in value.split("."))
+                and module != self._current_module_name
+            ):
+                self._typing_imports.add(module)
+            # Escape quotes as well: forward references can themselves contain strings.
+            return '"%s"' % value.replace("\\", "\\\\").replace('"', '\\"').replace(
+                "\n", "\\n"
+            ).replace("\r", "\\r")
+
+        def format_type(value):
+            if value is None or value is type(None):
+                return "None"
+            if isinstance(value, str):
+                if value == self._current_name:
+                    return forward_reference(value)
+                namespace = (
+                    self._current_parent_module.__dict__
+                    if self._current_parent_module is not None
+                    else globals()
+                )
+                try:
+                    resolved = eval(value, namespace)
+                except Exception:
+                    return forward_reference(value)
+                if isinstance(resolved, str):
+                    return forward_reference(resolved)
+                return format_type(resolved)
+            if isinstance(value, ForwardRef):
+                return forward_reference(value.__forward_arg__)
+            if isinstance(value, TypeVar) or hasattr(value, "__supertype__"):
+                return self._get_element_name_with_module(value)
+
+            origin = typing.get_origin(value)
+            args = typing.get_args(value)
+            if origin is not None:
+                if origin is UnionType:
+                    return " | ".join(format_type(arg) for arg in args)
+                if origin is typing.Literal:
+                    self._imports.add("typing")
+                    return "typing.Literal[%s]" % ", ".join(repr(arg) for arg in args)
+                if origin is typing.Annotated:
+                    self._imports.add("typing")
+                    return "typing.Annotated[%s, %s]" % (
+                        format_type(args[0]),
+                        ", ".join(self._format_default(arg) for arg in args[1:]),
+                    )
 
+                typing_name = getattr(value, "_name", None)
+                if origin is typing.Union:
+                    typing_name = typing_name or "Union"
+                if typing_name:
+                    self._imports.add("typing")
+                    base = "typing." + typing_name
+                else:
+                    base = self._get_element_name_with_module(origin)
+                    if base.startswith("typing."):
