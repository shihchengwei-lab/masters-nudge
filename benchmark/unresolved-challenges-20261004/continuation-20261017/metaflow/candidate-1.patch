+    def _generate_class_stub(self, name: str, clazz: type) -> str:
+        """Describe class members statically, including members installed at runtime."""
+        doc = clazz.__dict__.get("__doc__") or ""
+        if "STUBGEN_IGNORE" in doc:
+            return ""
+        previous_name = self._current_name
+        previous_parent = self._current_parent_module
+        self._current_name = name
+        self._current_parent_module = inspect.getmodule(clazz) or previous_parent
+        try:
+            typed_dict = getattr(typing, "is_typeddict", lambda _: False)(clazz)
+            named_tuple = issubclass(clazz, tuple) and hasattr(clazz, "_fields")
+            annotations = dict(clazz.__dict__.get("__annotations__", {}))
+            # A member may have both a field annotation and a descriptor. The
+            # descriptor determines its declaration; the annotation supplies types.
+            members = {
+                key: (annotations.get(key, inspect.Parameter.empty), value)
+                for key, value in clazz.__dict__.items()
+            }
+            for key, annotation in annotations.items():
+                members.setdefault(key, (annotation, inspect.Parameter.empty))
+
+            def is_method_or_property(member):
+                return isinstance(
+                    member, (property, staticmethod, classmethod)
+                ) or inspect.isroutine(member)
+
+            defaults = {}
+            if typed_dict:
+                self._imports.add("typing")
+                bases = ["typing.TypedDict"]
+                if not clazz.__total__:
+                    bases.append("total=False")
+            elif named_tuple:
+                self._imports.add("typing")
+                bases = ["typing.NamedTuple"]
+                annotations = {
+                    field: annotations.get(field, Any) for field in clazz._fields
+                }
+                defaults = getattr(clazz, "_field_defaults", {})
+            else:
+                bases = []
+                for base in clazz.__dict__.get("__orig_bases__", clazz.__bases__):
+                    if base is object:
+                        continue
+                    self._get_element_name_with_module(
+                        typing.get_origin(base) or base, force_import=True
+                    )
+                    bases.append(self._exploit_annotation(base, ""))
+                metaclass = type(clazz)
+                if metaclass is not type:
+                    bases.append(
+                        "metaclass="
+                        + self._get_element_name_with_module(
+                            metaclass, force_import=True
+                        )
+                    )
 
+            body = []
+            if doc:
+                body.append(self._format_docstring(doc, TAB))
+            for field, annotation in annotations.items():
+                if field.startswith("_") and not (typed_dict or named_tuple):
+                    continue
+                if not (typed_dict or named_tuple) and is_method_or_property(
+                    members[field][1]
+                ):
+                    continue
+                text = self._exploit_annotation(
+                    type(None) if annotation is None else annotation, ""
+                )
+                if typed_dict and typing.get_origin(annotation) not in (
+                    getattr(typing, "Required", None),
+                    getattr(typing, "NotRequired", None),
+                ):
+                    # TypedDict merges inherited annotations, but __total__ only
+                    # describes the current class. Preserve each inherited key's status.
+                    if (
+                        field in getattr(clazz, "__required_keys__", ())
+                        and not clazz.__total__
+                    ):
+                        text = "typing.Required[%s]" % text
+                    elif (
+                        field in getattr(clazz, "__optional_keys__", ())
+                        and clazz.__total__
+                    ):
+                        text = "typing.NotRequired[%s]" % text
+                line = TAB + field + ": " + text
+                if field in defaults:
+                    line += " = " + self._format_default(defaults[field])
+                body.append(line + "\n")
+
+            additions = {}
+            if clazz is Current:
+                for injected_members in self._addl_current.values():
+                    additions.update(injected_members)
+            metaflow_signatures = self._metaflow_class_signatures(clazz)
+
+            for attr_name, (annotation, attr) in members.items():
+                if attr_name in additions:
+                    continue
+                if attr_name in annotations and (
+                    typed_dict or named_tuple or not is_method_or_property(attr)
+                ):
+                    continue
+                if attr_name.startswith("_") and not (
+                    attr_name.startswith("__") and attr_name.endswith("__")
+                ):
+                    continue
+                if attr_name in (
+                    "__dict__",
+                    "__weakref__",
+                    "__doc__",
+                    "__module__",
+                    "__annotations__",
+                    "__slots__",
+                    "__orig_bases__",
+                    "__parameters__",
+                    "__classcell__",
+                ):
+                    continue
+                if typed_dict or (named_tuple and attr_name.startswith("__")):
+                    continue
+                if isinstance(attr, property):
+                    if attr.fget is not None:
+                        signatures = [
+                            signature.replace(return_annotation=annotation)
+                            if signature.return_annotation is inspect.Signature.empty
+                            else signature
+                            for signature in self._function_signatures(attr.fget)
+                        ]
+                        body.append(
+                            self._generate_function_stub(
+                                attr_name, attr.fget, sign=signatures,
+                                indentation=TAB, deco="@property"
+                            )
+                        )
+                    if attr.fset is not None:
+                        signatures = []
+                        for signature in self._function_signatures(attr.fset):
+                            parameters = list(signature.parameters.values())
+                            if (
+                                len(parameters) > 1
+                                and parameters[1].annotation is inspect.Parameter.empty
+                            ):
+                                parameters[1] = parameters[1].replace(annotation=annotation)
+                                signature = signature.replace(parameters=parameters)
+                            signatures.append(signature)
+                        body.append(
+                            self._generate_function_stub(
+                                attr_name, attr.fset, sign=signatures,
+                                indentation=TAB, deco="@%s.setter" % attr_name
+                            )
+                        )
+                    if attr.fdel is not None:
+                        body.append(
+                            self._generate_function_stub(
+                                attr_name, attr.fdel,
+                                indentation=TAB, deco="@%s.deleter" % attr_name
+                            )
+                        )
+                elif isinstance(attr, (staticmethod, classmethod)) or inspect.isroutine(
+                    attr
+                ):
+                    signatures, member_doc = metaflow_signatures.get(
+                        attr_name, (None, None)
+                    )
+                    body.append(
+                        self._generate_function_stub(
+                            attr_name, attr, sign=signatures,
+                            doc=member_doc, indentation=TAB
+                        )
+                    )
+                elif (
+                    inspect.isclass(attr)
+                    and attr.__module__ == clazz.__module__
+                    and attr.__qualname__.startswith(clazz.__qualname__ + ".")
+                ):
+                    body.append(
+                        add_indent(TAB, self._generate_class_stub(attr_name, attr)) + "\n"
+                    )
+                elif not attr_name.startswith("_"):
+                    body.append(TAB + self._generate_generic_stub(attr_name, attr))
+
+            for attr_name, addition in additions.items():
+                if isinstance(addition, str):
+                    module_name, _, member_name = addition.rpartition(".")
+                    func = getattr(importlib.import_module(module_name), member_name)
+                    body.append(
+                        self._generate_function_stub(attr_name, func, indentation=TAB)
+                    )
+                else:
+                    signature, member_doc = addition
+                    body.append(
+                        self._generate_function_stub(
+                            attr_name, sign=[signature], doc=member_doc,
+                            indentation=TAB, deco="@property"
+                        )
+                    )
 
+            declaration = "class " + name + ("(%s)" % ", ".join(bases) if bases else "")
+            return declaration + ":\n" + ("".join(body) or TAB + "...\n")
+        finally:
+            self._current_name = previous_name
+            self._current_parent_module = previous_parent
 
+    def _extract_signature_from_decorator(
+        self, name: str, raw_doc: Optional[str], is_flow_decorator: bool = False
+    ) -> Optional[List[Tuple[inspect.Signature, str]]]:
+        # TODO: This only handles the `Parameters` section for now; we are
+        # using it only to parse the documentation for step/flow decorators so
+        # this is enough for now but it could be extended more.
+        # Inspired from:
+        # https://github.com/rr-/docstring_parser/blob/master/docstring_parser/numpydoc.py
+        if raw_doc is None:
+            return None
 
+        if not "FlowSpecDerived" in self._typevars:
+            self._typevars["FlowSpecDerived"] = FlowSpecDerived
+            self._typevars["StepFlag"] = StepFlag
 
+        raw_doc = inspect.cleandoc(raw_doc)
+        section_boundaries = [
+            ("func_doc", StartEnd(0, 0)),
+            (
+                "param_doc",
+                param_section_header.search(raw_doc)
+                or StartEnd(len(raw_doc), len(raw_doc)),
+            ),
+            (
+                "add_to_current_doc",
+                add_to_current_header.search(raw_doc)
+                or StartEnd(len(raw_doc), len(raw_doc)),
+            ),
+        ]
 
+        docs = split_docs(raw_doc, section_boundaries)
+        parameters, no_arg_version = parse_params_from_doc(docs["param_doc"])
 
+        if docs["add_to_current_doc"]:
+            self._addl_current[name] = parse_add_to_docs(docs["add_to_current_doc"])
 
