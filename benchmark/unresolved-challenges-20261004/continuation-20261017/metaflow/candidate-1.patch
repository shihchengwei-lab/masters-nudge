+def test_annotated_property_preserves_overloaded_accessors(generator):
+    clazz = define(generator, """
+class OverloadedProperty:
+    value: int
+    @property
+    def value(self): pass
+    @value.setter
+    @typing.overload
+    def value(self, value: int) -> None: ...
+    @value.setter
+    @typing.overload
+    def value(self, value: str) -> None: ...
+    @value.setter
+    def value(self, value): pass
+""", "OverloadedProperty")
+    # Property getter/setter functions share a qualified name. Use separate
+    # overload registries, as ordinary property accessors may also use functions
+    # defined outside the class.
+    getter = define(generator, """
+@typing.overload
+def get_value(self, *, raw: typing.Literal[True]) -> bytes: ...
+@typing.overload
+def get_value(self, *, raw: typing.Literal[False] = False) -> str: ...
+def get_value(self, *, raw=False): pass
+""", "get_value")
+    clazz.value = property(getter, clazz.value.fset)
+    node = class_node(generator, clazz)
+    methods = [n for n in node.body if isinstance(n, ast.FunctionDef)]
+    getters = [n for n in methods if any(ast.unparse(d) == "property" for d in n.decorator_list)]
+    setters = [n for n in methods if any(ast.unparse(d) == "value.setter" for d in n.decorator_list)]
+    assert [ast.unparse(n.returns) for n in getters] == ["bytes", "str"]
+    assert [ast.unparse(n.args.args[1].annotation) for n in setters] == ["int", "str"]
+    assert all("typing.overload" in [ast.unparse(d) for d in n.decorator_list] for n in getters + setters)
+
