+    def _function_signatures(self, func: Callable) -> List[inspect.Signature]:
+        overloads = (
+            getattr(typing, "get_overloads", lambda _: [])(func)
+            if inspect.isfunction(func)
+            else []
+        )
+        try:
+            return [inspect.signature(f) for f in overloads or [func]]
+        except (TypeError, ValueError):
+            return []
