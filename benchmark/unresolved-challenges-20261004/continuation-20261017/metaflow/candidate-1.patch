+                    return "%s[%s, %s]" % (base, parameters, format_type(result))
+                if not args:
+                    # Empty tuple aliases have arguments (), unlike unsubscripted Tuple.
+                    return base + ("[()]" if repr(value).endswith("[()]") else "")
+                return "%s[%s]" % (base, ", ".join(format_type(arg) for arg in args))
+
+            if getattr(value, "__module__", None) == "typing":
+                self._imports.add("typing")
+            return self._get_element_name_with_module(value)
+
