+import ast
+import collections
+import datetime
+import inspect
+import sys
+import types
+import typing
+
+import pytest
+
+from metaflow.cmd.develop import stub_generator
+
+
+@pytest.fixture
+def generator(tmp_path, monkeypatch):
+    # Version metadata is irrelevant here; do not query the checkout's history.
+    monkeypatch.setattr(stub_generator, "get_version", lambda: "test")
+    monkeypatch.setenv("METAFLOW_STUBGEN", "1")
+    gen = stub_generator.StubGenerator(str(tmp_path / "stubs"))
+    module = types.ModuleType("stub_example")
+    module.__dict__.update(typing=typing, datetime=datetime)
+    monkeypatch.setitem(sys.modules, module.__name__, module)
+    gen._current_module = gen._current_parent_module = module
+    gen._current_module_name = module.__name__
+    return gen
+
+
+def define(generator, source, name):
+    exec(source, generator._current_module.__dict__)
+    return getattr(generator._current_module, name)
+
+
+def class_node(generator, clazz):
+    source = generator._generate_class_stub(clazz.__name__, clazz)
+    return ast.parse(source).body[0]
+
+
+@pytest.mark.parametrize("annotation", [None, inspect.Parameter.empty])
+def test_empty_annotations(generator, annotation):
+    assert generator._exploit_annotation(annotation) == ""
+
+
+@pytest.mark.parametrize(
+    "annotation, expected",
+    [
+        (int, "int"),
+        (type(None), "None"),
+        (typing.Any, "typing.Any"),
+        (typing.List[int], "typing.List[int]"),
+        (typing.Optional[str], "typing.Optional[str]"),
+        (typing.Union[str, int], "typing.Union[str, int]"),
+        (typing.Callable[[int, str], bool], "typing.Callable[[int, str], bool]"),
+        (typing.Callable[[], bool], "typing.Callable[[], bool]"),
+        (typing.Callable[..., bool], "typing.Callable[..., bool]"),
+        (typing.Tuple[int, ...], "typing.Tuple[int, ...]"),
+        (list[dict[str, int]], "list[dict[str, int]]"),
+    ],
+)
+def test_annotation_formatting(generator, annotation, expected):
+    assert generator._exploit_annotation(annotation, " -> ") == " -> " + expected
+    if "typing." in expected:
+        assert "typing" in generator._imports
+
+
+def test_annotations_preserve_literal_values_and_metadata(generator):
