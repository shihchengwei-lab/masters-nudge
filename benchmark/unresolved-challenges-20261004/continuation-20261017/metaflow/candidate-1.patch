+    def _format_default(self, value: Any) -> str:
+        """Keep Python literals and class defaults; opaque runtime objects become ... ."""
+        if inspect.isclass(value):
+            return self._get_element_name_with_module(value, force_import=True)
+        try:
+            text = repr(value)
+            ast.literal_eval(text)
+        except Exception:
+            return "..."
+        return text
