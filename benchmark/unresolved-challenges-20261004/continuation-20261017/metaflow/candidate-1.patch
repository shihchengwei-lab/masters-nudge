+    def _format_docstring(self, doc: str, indentation: str) -> str:
+        doc = inspect.cleandoc(doc).replace("\\", "\\\\").replace('"', '\\"')
+        return add_indent(indentation, '"""' + doc + '"""') + "\n"
+
+    def _format_definition_type(self, annotation):
+        # TypeVar/NewType arguments are expressions, even with postponed
+        # annotations. Their dependencies need imports outside TYPE_CHECKING.
+        def require_import(value):
+            if isinstance(value, (str, ForwardRef, TypeVar)) or hasattr(
+                value, "__supertype__"
+            ):
+                return
+            module = getattr(value, "__module__", None)
+            if module and module not in ("builtins", "__main__"):
+                module = self._get_module_name_alias(module)
+                if module != self._current_module_name:
+                    self._imports.add(module)
+            for arg in typing.get_args(value):
+                require_import(arg)
+
+        require_import(annotation)
+        return self._exploit_annotation(annotation, "")
+
+    def _metaflow_class_signatures(self, clazz):
+        """Recover signatures for the public APIs supplied by deployer providers."""
+        result = {}
+
+        def remember(provider, kind):
+            provider_type = getattr(provider, "TYPE", None)
+            if provider_type:
+                info = self._deployer_injected_methods.setdefault(
+                    provider_type.replace("-", "_"), {}
+                )
+                info[kind] = (
+                    provider.__module__ + "." + provider.__name__,
+                    provider.__doc__ or "",
+                )
 
+        def resolve(path):
+            module, _, symbol = path.rpartition(".")
+            return getattr(importlib.import_module(module), symbol)
 
+        def raw_function(func):
+            return getattr(func, "__func__", func)
 
+        def documented_signature(signature, doc, return_type):
+            if (
+                return_type is not inspect.Signature.empty
+                and signature.return_annotation is inspect.Signature.empty
+            ):
+                signature = signature.replace(return_annotation=return_type)
+            if not any(
+                p.kind is inspect.Parameter.VAR_KEYWORD
+                for p in signature.parameters.values()
+            ):
+                return signature
+            clean_doc = inspect.cleandoc(doc or "")
+            section = param_section_header.search(clean_doc)
+            if section is None:
+                return signature
+            param_doc = clean_doc[section.end() :]
+            next_section = re.search(r"\n\S[^\n]*\n-{3,}\s*\n", param_doc)
+            if next_section:
+                param_doc = param_doc[: next_section.start()]
+            try:
+                documented, _ = parse_params_from_doc(param_doc)
+                if not documented:
+                    return signature
+                parameters = [
+                    p
+                    for p in signature.parameters.values()
+                    if p.kind is not inspect.Parameter.VAR_KEYWORD
+                ]
+                names = {p.name for p in parameters}
+                parameters.extend(p for p in documented if p.name not in names)
+                return signature.replace(parameters=parameters)
+            except (TypeError, ValueError):
+                # Some APIs document **kwargs itself instead of individual options.
+                return signature
+
+        def documented_signatures(func, doc, return_type=inspect.Signature.empty):
+            return [
+                documented_signature(signature, doc, return_type)
+                for signature in self._function_signatures(raw_function(func))
+            ]
 
+        if issubclass(clazz, DeployerImpl):
+            remember(clazz, "deployer")
+        elif issubclass(clazz, DeployedFlow):
+            remember(clazz, "deployed_flow")
+
+        if clazz in (Deployer, DeployedFlow):
+            from metaflow.plugins import DEPLOYER_IMPL_PROVIDERS
+
+            for provider in DEPLOYER_IMPL_PROVIDERS:
+                remember(provider, "deployer")
+                if clazz is DeployedFlow:
+                    remember(provider.deployed_flow_type(), "deployed_flow")
+            for method_name, info in self._deployer_injected_methods.items():
+                if clazz is Deployer and "deployer" in info:
+                    provider_path, provider_doc = info["deployer"]
+                    if method_name in clazz.__dict__:
+                        result[method_name] = (
+                            documented_signatures(
+                                clazz.__dict__[method_name],
+                                provider_doc,
+                                resolve(provider_path),
+                            ),
+                            provider_doc,
+                        )
+                elif clazz is DeployedFlow and "deployed_flow" in info:
+                    deployed = resolve(info["deployed_flow"][0])
+                    trigger_type = inspect.signature(deployed.trigger).return_annotation
+                    for injected, original, return_type in (
+                        ("from_" + method_name, "from_deployment", deployed),
+                        (
+                            "list_" + method_name,
+                            "list_deployed_flows",
+                            typing.Iterator[deployed],
+                        ),
+                        (
+                            "get_triggered_" + method_name + "_run",
+                            "get_triggered_run",
+                            trigger_type,
+                        ),
+                    ):
+                        if injected in clazz.__dict__:
+                            func = clazz.__dict__[injected]
+                            member_doc = getattr(
+                                getattr(deployed, original, None), "__doc__", None
+                            ) or ""
+                            result[injected] = (
+                                documented_signatures(func, member_doc, return_type),
+                                member_doc,
+                            )
+        elif issubclass(clazz, (DeployerImpl, DeployedFlow, TriggeredRun)):
+            for method_name, member in clazz.__dict__.items():
+                func = raw_function(member)
+                if not inspect.isfunction(func) or method_name.startswith("_"):
+                    continue
+                return_type = inspect.Signature.empty
+                if issubclass(clazz, DeployedFlow):
+                    if method_name == "from_deployment":
+                        return_type = clazz
+                    elif method_name == "list_deployed_flows":
+                        return_type = typing.Iterator[clazz]
+                    elif method_name == "get_triggered_run" and hasattr(
+                        clazz, "trigger"
+                    ):
+                        return_type = inspect.signature(clazz.trigger).return_annotation
+                member_doc = func.__doc__ or ""
+                result[method_name] = (
+                    documented_signatures(func, member_doc, return_type), member_doc
+                )
