+#[test]
+fn unrelated_cache_rebuilds_preserve_pending_dynamic_decisions() {
+    for new_subscriber in [false, true].iter().copied() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let filter_calls = calls.clone();
+        let observed = Count::default();
+        let subscriber = Registry::default().with(observed.clone().with_filter(dynamic_filter_fn(
+            move |_, _| {
+                filter_calls.fetch_add(1, Ordering::SeqCst);
+                true
+            },
+        )));
+        tracing::subscriber::with_default(subscriber, || {
+            tracing::info!(
+                value = {
+                    if new_subscriber {
+                        let _other = tracing::Dispatch::new(Registry::default());
+                    } else {
+                        tracing_core::callsite::rebuild_interest_cache();
+                    }
+                    1
+                }
+            );
+        });
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert_eq!(observed.0.load(Ordering::SeqCst), 1);
+    }
+}
