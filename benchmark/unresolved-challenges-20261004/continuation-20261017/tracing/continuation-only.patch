+#[test]
+fn custom_subscriber_updates_current_before_reentrant_callbacks() {
+    let observed = Observe::default();
+    let subscriber = OpaqueRegistry(Registry::default())
+        .with(EmitOnEnterAndExit)
+        .with(
+            observed
+                .clone()
+                .with_filter(filter_fn(|m| m.name() != "hidden")),
+        );
+    tracing::subscriber::with_default(subscriber, || {
+        let visible = tracing::info_span!("visible").entered();
+        let hidden = tracing::info_span!(parent: None, "hidden").entered();
+        drop(hidden);
+        drop(visible);
+    });
+    let expected = [Some("visible"), Some("visible"), Some("visible"), None]
+        .iter()
+        .map(|name| View {
+            current: *name,
+            lookup: *name,
+            scope: name.iter().copied().collect(),
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(*observed.0.lock().unwrap(), expected);
+}
