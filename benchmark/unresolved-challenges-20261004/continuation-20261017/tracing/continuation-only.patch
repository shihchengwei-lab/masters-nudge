+#[test]
+fn dynamic_reload_invalidates_pending_decisions_with_unchanged_interest() {
+    let observed = Count::default();
+    let (filter, handle) = tracing_subscriber::reload::Layer::new(Toggle(true));
+    let subscriber = Registry::default().with(observed.clone().with_filter(filter));
+    tracing::subscriber::with_default(subscriber, || {
+        tracing::info!(
+            value = {
+                handle.reload(Toggle(false)).unwrap();
+                1
+            }
+        );
+    });
+    assert_eq!(observed.0.load(Ordering::SeqCst), 0);
+}
