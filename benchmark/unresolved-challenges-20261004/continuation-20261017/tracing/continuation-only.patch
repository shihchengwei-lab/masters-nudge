--- /dev/null
+++ b/tracing-subscriber/tests/filter_continuation_regressions.rs
@@ -0,0 +1,346 @@
+#![cfg(feature = "registry")]
+
+use std::sync::{
+    atomic::{AtomicUsize, Ordering},
+    Arc, Mutex,
+};
+use tracing::{span, Event, Metadata, Subscriber};
+use tracing_core::{span::Current, Interest};
+use tracing_subscriber::{
+    filter::{dynamic_filter_fn, filter_fn, LevelFilter},
+    layer::{Context, Filter},
+    prelude::*,
+    registry::{LookupSpan, Registry},
+    Layer,
+};
+
+#[derive(Clone, Default)]
+struct Count(Arc<AtomicUsize>);
+
+impl<S: Subscriber> Layer<S> for Count {
+    fn on_event(&self, _: &Event<'_>, _: Context<'_, S>) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+struct GlobalGate {
+    cached: bool,
+    bound: LevelFilter,
+}
+
+impl GlobalGate {
+    fn allows(&self, metadata: &Metadata<'_>) -> bool {
+        metadata.target() != "blocked" && metadata.level() <= &self.bound
+    }
+}
+
+impl<S: Subscriber> Layer<S> for GlobalGate {
+    fn enabled(&self, metadata: &Metadata<'_>, _: Context<'_, S>) -> bool {
+        self.allows(metadata)
+    }
+
+    fn register_callsite(&self, metadata: &'static Metadata<'static>) -> Interest {
+        if !self.cached {
+            Interest::sometimes()
+        } else if self.allows(metadata) {
+            Interest::always()
+        } else {
+            Interest::never()
+        }
+    }
+
+    fn max_level_hint(&self) -> Option<LevelFilter> {
+        Some(self.bound)
+    }
+}
+
+#[test]
+fn wrapped_global_veto_survives_local_acceptance_and_rejection() {
+    for cached in [false, true].iter().copied() {
+        for local in [false, true].iter().copied() {
+            let inner = Count::default();
+            let outer = Count::default();
+            let fields = AtomicUsize::new(0);
+            let subscriber = Registry::default()
+                .with(inner.clone())
+                .with(
+                    GlobalGate {
+                        cached,
+                        bound: LevelFilter::TRACE,
+                    }
+                    .and_then(Count::default().with_filter(LevelFilter::TRACE))
+                    .with_filter(filter_fn(move |_| local))
+                    .with_filter(LevelFilter::TRACE),
+                )
+                .with(outer.clone());
+            tracing::subscriber::with_default(subscriber, || {
+                for _ in 0..3 {
+                    tracing::info!(target: "blocked", value = fields.fetch_add(1, Ordering::SeqCst));
+                    assert!(tracing::info_span!(target: "blocked", "blocked_span").is_disabled());
+                }
+            });
+            assert_eq!(
+                fields.load(Ordering::SeqCst),
+                0,
+                "cached={}, local={}",
+                cached,
+                local
+            );
+            assert_eq!(inner.0.load(Ordering::SeqCst), 0);
+            assert_eq!(outer.0.load(Ordering::SeqCst), 0);
+        }
+    }
+}
+
+#[test]
+fn wrapped_global_hint_still_bounds_independent_consumers() {
+    let subscriber = Registry::default().with(Count::default()).with(
+        GlobalGate {
+            cached: true,
+            bound: LevelFilter::INFO,
+        }
+        .with_filter(LevelFilter::OFF),
+    );
+    assert_eq!(subscriber.max_level_hint(), Some(LevelFilter::INFO));
+}
+
+#[test]
+fn wrapped_pure_global_filter_does_not_add_a_consumer() {
+    let subscriber = Registry::default()
+        .with(Count::default().with_filter(LevelFilter::OFF))
+        .with(LevelFilter::TRACE.with_filter(LevelFilter::TRACE));
+    assert_eq!(subscriber.max_level_hint(), Some(LevelFilter::OFF));
+    tracing::subscriber::with_default(subscriber, || {
+        assert!(tracing::info_span!("unobserved").is_disabled());
+    });
+}
+
+#[derive(Debug, PartialEq)]
+struct View {
+    current: Option<&'static str>,
+    lookup: Option<&'static str>,
+    scope: Vec<&'static str>,
+}
+
+#[derive(Clone, Default)]
+struct Observe(Arc<Mutex<Vec<View>>>);
+
+impl<S> Layer<S> for Observe
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn on_event(&self, event: &Event<'_>, ctx: Context<'_, S>) {
+        self.0.lock().unwrap().push(View {
+            current: ctx.current_span().metadata().map(|m| m.name()),
+            lookup: ctx.lookup_current().map(|span| span.name()),
+            scope: ctx
+                .event_scope(event)
+                .into_iter()
+                .flatten()
+                .map(|span| span.name())
+                .collect(),
+        });
+    }
+}
+
+fn check_entered_view<S>(subscriber: S)
+where
+    S: Subscriber + Send + Sync + for<'a> LookupSpan<'a>,
+{
+    let observed = Observe::default();
+    let subscriber = subscriber
+        .with(
+            observed
+                .clone()
+                .with_filter(filter_fn(|m| !m.name().starts_with("hidden")))
+                .with_filter(LevelFilter::INFO),
+        )
+        .with(Count::default());
+    tracing::subscriber::with_default(subscriber, || {
+        let visible = tracing::info_span!("visible");
+        let entered_visible = visible.enter();
+        let hidden = tracing::info_span!(parent: None, "hidden_root");
+        let entered_hidden = hidden.enter();
+        tracing::info!("independent roots");
+
+        let not_entered = tracing::info_span!(parent: None, "not_entered");
+        let child = tracing::info_span!(parent: &not_entered, "hidden_child");
+        let entered_child = child.enter();
+        tracing::info!("an unentered parent is not current");
+
+        let other = tracing::info_span!(parent: None, "other");
+        let entered_other = other.enter();
+        let duplicate_visible = visible.enter();
+        tracing::info!("duplicate entries preserve the subscriber's current ordering");
+        drop(duplicate_visible);
+        drop(entered_visible);
+        tracing::info!("exit an earlier root out of order");
+        drop(entered_other);
+        tracing::info!("only hidden spans remain entered");
+        drop(entered_child);
+        drop(entered_hidden);
+        tracing::info!("all spans exited");
+    });
+    let expected = [
+        Some("visible"),
+        Some("visible"),
+        Some("other"),
+        Some("other"),
+        None,
+        None,
+    ]
+    .iter()
+    .map(|name| View {
+        current: *name,
+        lookup: *name,
+        scope: name.iter().copied().collect(),
+    })
+    .collect::<Vec<_>>();
+    assert_eq!(*observed.0.lock().unwrap(), expected);
+}
+
+#[test]
+fn registry_current_view_uses_entered_spans_instead_of_parents() {
+    check_entered_view(Registry::default());
+}
+
+// Deliberately does not expose Registry by downcasting.
+struct OpaqueRegistry(Registry);
+
+impl Subscriber for OpaqueRegistry {
+    fn enabled(&self, metadata: &Metadata<'_>) -> bool {
+        self.0.enabled(metadata)
+    }
+    fn new_span(&self, attrs: &span::Attributes<'_>) -> span::Id {
+        self.0.new_span(attrs)
+    }
+    fn record(&self, id: &span::Id, values: &span::Record<'_>) {
+        self.0.record(id, values)
+    }
+    fn record_follows_from(&self, id: &span::Id, follows: &span::Id) {
+        self.0.record_follows_from(id, follows)
+    }
+    fn event(&self, event: &Event<'_>) {
+        self.0.event(event)
+    }
+    fn enter(&self, id: &span::Id) {
+        self.0.enter(id)
+    }
+    fn exit(&self, id: &span::Id) {
+        self.0.exit(id)
+    }
+    fn clone_span(&self, id: &span::Id) -> span::Id {
+        self.0.clone_span(id)
+    }
+    fn try_close(&self, id: span::Id) -> bool {
+        self.0.try_close(id)
+    }
+    fn current_span(&self) -> Current {
+        self.0.current_span()
+    }
+}
+
+impl<'a> LookupSpan<'a> for OpaqueRegistry {
+    type Data = tracing_subscriber::registry::Data<'a>;
+
+    fn span_data(&'a self, id: &span::Id) -> Option<Self::Data> {
+        self.0.span_data(id)
+    }
+}
+
+#[test]
+fn custom_subscriber_current_view_uses_entered_spans_instead_of_parents() {
+    check_entered_view(OpaqueRegistry(Registry::default()));
+}
+
+struct EmitOnEnterAndExit;
+
+impl<S: Subscriber> Layer<S> for EmitOnEnterAndExit {
+    fn on_enter(&self, _: &span::Id, _: Context<'_, S>) {
+        tracing::info!("event from on_enter");
+    }
+
+    fn on_exit(&self, _: &span::Id, _: Context<'_, S>) {
+        tracing::info!("event from on_exit");
+    }
+}
