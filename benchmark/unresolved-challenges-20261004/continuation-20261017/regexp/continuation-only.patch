index 0000000..2509c87
--- /dev/null
+++ b/tests/lib/rules/no-dupe-disjunctions-continuation.ts
@@ -0,0 +1,216 @@
+import assert from "assert"
+import { RuleTester } from "eslint"
+import rule from "../../../lib/rules/no-dupe-disjunctions"
+
+const tester = new RuleTester({
+    parserOptions: { ecmaVersion: 2020, sourceType: "module" },
+})
+
+const nestedSubset = {
+    message:
+        "Unexpected useless element. All paths of '[abc]' that go through 'a' (U+0061) are a strict subset of 'a+'. This element can be removed.",
+    column: 9,
+    endColumn: 10,
+}
+const overlap = {
+    message:
+        "Unexpected overlap. This alternative overlaps with 'a+'. The overlap is 'a'. This ambiguity is likely to cause exponential backtracking.",
+    column: 8,
+    endColumn: 13,
+}
+const equality = {
+    message:
+        "Unexpected useless element. All paths of '(?:ab|a)' that go through 'ab' are already covered by 'ab'. This element can be removed.",
+    column: 8,
+    endColumn: 10,
+}
+
+tester.run("no-dupe-disjunctions continuation", rule as any, {
+    valid: [
+        String.raw`/(?:a+|([ab]))(?!\1)/`,
+        String.raw`/(?:a+|(?<letter>[ab]))(?!\k<letter>)/`,
+        String.raw`/(?:a+|(?:(a)|b))(?!\1)/`,
+        String.raw`/(?:a+|(?:([ab])|c))(?!\1)/`,
+        String.raw`/(?:(a)+|[ab])(?=\1)/`,
+        String.raw`/(?:a+x|[ab](x))(?!\1)/`,
+        String.raw`/(?:[abc]*a[abc]*|(?:(?:[ab]|(c))){2})(?!\1)/`,
+        {
+            code: `const fragment = /a|[ab]a/.source`,
+            options: [{ reportUnreachable: "certain" }],
+        },
+    ],
+    invalid: [
+        {
+            code: String.raw`/(?:a+|(?:[ab]|(c)))\1/`,
+            errors: [
+                {
+                    message:
+                        "Unexpected useless element. All paths of '(?:[ab]|(c))' that go through 'a' (U+0061) are a strict subset of 'a+'. This element can be removed.",
+                    column: 12,
+                    endColumn: 13,
+                },
+            ],
+        },
+        {
+            code: String.raw`/(?:(?:a+|(c))|[ab])\1/`,
+            errors: [
+                {
+                    message:
+                        "Unexpected useless element. All paths of '[ab]' that go through 'a' (U+0061) are a strict subset of '(?:a+|(c))'. This element can be removed.",
+                    column: 17,
+                    endColumn: 18,
+                },
+            ],
+        },
+        ...[
+            String.raw`/(?:(?:a+|(c)){1,2}|[ab])\1/`,
+            String.raw`/(?:(c)?a+|[ab])\1/`,
+        ].map((code) => ({
+            code,
+            errors: [
+                {
+                    message: `Unexpected useless element. All paths of '[ab]' that go through 'a' (U+0061) are a strict subset of '${
+                        code.includes("{1,2}") ? "(?:a+|(c)){1,2}" : "(c)?a+"
+                    }'. This element can be removed.`,
+                    column: code.indexOf("[ab]") + 2,
+                    endColumn: code.indexOf("[ab]") + 3,
+                },
+            ],
+        })),
+        ...[
+            String.raw`/\1(?:(?:a+|(c))|[ab]c)/`,
+            String.raw`/(?<=(?:(?:a+|(c))|c[ab])\1)/`,
+        ].map((code) => ({
+            code,
+            errors: [
+                {
+                    message: `Unexpected useless element. All paths of '${
+                        code.includes("?<=") ? "c[ab]" : "[ab]c"
+                    }' that go through 'a' (U+0061) are already covered by '(?:a+|(c))'. This element can be removed.`,
+                    column: code.indexOf("[ab]") + 2,
+                    endColumn: code.indexOf("[ab]") + 3,
+                },
+            ],
+        })),
+        {
+            code: `/(?:a+|[abc])+/`,
+            errors: [overlap, nestedSubset],
+        },
+        ...["all", "trivial", "interesting"].flatMap((report) =>
+            ["none", "certain", "potential"].map(
+                (reportExponentialBacktracking) => ({
+                    code: `/(?:a+|[abc])+/`,
+                    options: [{ report, reportExponentialBacktracking }],
+                    errors:
+                        reportExponentialBacktracking === "none"
+                            ? [nestedSubset]
+                            : [overlap, nestedSubset],
+                }),
+            ),
+        ),
+        {
+            code: `/(?:a+|[ab])+$/`,
+            options: [
+                { report: "all", reportExponentialBacktracking: "certain" },
+            ],
+            errors: [
+                { ...overlap, endColumn: 12 },
+                {
+                    ...nestedSubset,
+                    message:
+                        "Unexpected useless element. All paths of '[ab]' that go through 'a' (U+0061) are a strict subset of 'a+'. This element can be removed.",
+                },
+            ],
+        },
+        {
+            code: `const fragment = /a+|[abc]/.source`,
+            options: [{ reportExponentialBacktracking: "certain" }],
+            errors: [{ ...nestedSubset, column: 23, endColumn: 24 }],
+        },
+        {
+            code: `const fragment = /a+|[abc]/.source`,
+            options: [{ reportExponentialBacktracking: "potential" }],
+            errors: [
+                {
+                    ...overlap,
+                    message:
+                        "Unexpected overlap. This alternative overlaps with 'a+'. The overlap is 'a'. This ambiguity might cause exponential backtracking.",
+                    column: 22,
+                    endColumn: 27,
+                },
+                { ...nestedSubset, column: 23, endColumn: 24 },
+            ],
+        },
+        {
+            code: `/ab|(?:ab|a)/`,
+            errors: [equality],
+        },
+        {
+            code: `/(?:ab|(?:ab|a))c/`,
+            errors: [{ ...equality, column: 11, endColumn: 13 }],
+        },
+        {
+            code: `const fragment = /ab|(?:ab|a)/.source`,
+            options: [
+                {
+                    reportUnreachable: "certain",
+                    reportExponentialBacktracking: "none",
+                },
+            ],
+            errors: [{ ...equality, column: 25, endColumn: 27 }],
+        },
+        {
+            code: `/ab|(?:(ab)|a)/`,
+            errors: [
+                {
+                    message:
+                        "Unexpected useless element. All paths of '(?:(ab)|a)' that go through '(ab)' are already covered by 'ab'. This element can be removed. Careful! This alternative contains capturing groups which might be difficult to remove.",
+                    column: 8,
+                    endColumn: 12,
+                },
+            ],
+        },
+        {
+            code: `/a+|(?:(a)|b)/`,
+            errors: [
+                {
+                    message:
+                        "Unexpected useless element. All paths of '(?:(a)|b)' that go through '(a)' are a strict subset of 'a+'. This element can be removed. Careful! This alternative contains capturing groups which might be difficult to remove.",
+                    column: 8,
+                    endColumn: 11,
+                },
+            ],
+        },
+        {
+            code: String.raw`/(?:a+|([ab]))(?!\1)|c+|[cd]/`,
+            errors: [
+                {
+                    message:
+                        "Unexpected useless element. All paths of '[cd]' that go through 'c' (U+0063) are a strict subset of 'c+'. This element can be removed.",
+                    column: 26,
+                    endColumn: 27,
+                },
+            ],
+        },
+    ],
+})
+
+describe("no-dupe-disjunctions capture dependency witnesses", () => {
+    for (const [original, edited] of [
+        [String.raw`(?:a+|([ab]))(?!\1)`, String.raw`(?:a+|([b]))(?!\1)`],
+        [String.raw`(?:(a)+|[ab])(?=\1)`, String.raw`(?:(a)+|[b])(?=\1)`],
+        [String.raw`(?:a+x|[ab](x))(?!\1)`, String.raw`(?:a+x|[b](x))(?!\1)`],
+    ]) {
+        it(`preserves the necessary path in /${original}/`, () => {
+            const input = original.includes("x") ? "ax" : "a"
+            assert.strictEqual(new RegExp(original).test(input), true)
+            assert.strictEqual(new RegExp(edited).test(input), false)
+        })
+    }
+    it("keeps capture dependencies from other quantifier iterations", () => {
+        const original = String.raw`(?:[abc]*a[abc]*|(?:(?:[ab]|(c))){2})(?!\1)`
+        const edited = String.raw`(?:[abc]*a[abc]*|(?:(?:[b]|(c))){2})(?!\1)`
+        assert.strictEqual(new RegExp(original).test("ac"), true)
+        assert.strictEqual(new RegExp(edited).test("ac"), false)
+    })
+})
